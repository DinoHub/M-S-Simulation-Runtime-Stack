{
  "uid": "tevv-campaign-progress",
  "title": "TEVV campaign progress",
  "tags": [
    "tevv",
    "osmo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "campaign",
        "label": "Campaign",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tevv-registry"
        },
        "query": "SELECT campaign_id FROM campaigns ORDER BY updated_at DESC",
        "definition": "SELECT campaign_id FROM campaigns ORDER BY updated_at DESC",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Campaign progress",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tevv-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tevv-registry"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT campaign_id AS campaign, runs, pending, submitted, running, evaluating, passed, failed, infra, pass_rate_pct AS \"pass %\", last_update FROM v_campaign_progress WHERE campaign_id IN (${campaign:sqlstring}) ORDER BY last_update DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pass %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 50
                    },
                    {
                      "color": "green",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Runs (latest attempt of each)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tevv-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tevv-registry"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.campaign_id AS campaign, r.run_key AS run, r.attempt, r.status,\n       r.failure_reason AS reason, r.workflow_ref AS workflow,\n       round(extract(epoch FROM r.ended_at - r.submitted_at))::int AS \"duration s\",\n       (SELECT round(value::numeric, 3) FROM metrics_summary m WHERE (m.campaign_id, m.run_key, m.attempt)\n          = (r.campaign_id, r.run_key, r.attempt) AND m.metric = 'ate_rmse_m') AS \"ATE rmse m\",\n       r.recording_valid AS \"recording ok\", array_to_string(r.failed_checks, ', ') AS \"recording checks failed\",\n       r.updated_at AS updated, left(r.error, 120) AS error\nFROM v_latest_runs r WHERE r.campaign_id IN (${campaign:sqlstring}) ORDER BY r.updated_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "passed": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "infra_failed": {
                        "color": "orange",
                        "index": 2
                      },
                      "aborted": {
                        "color": "purple",
                        "index": 3
                      },
                      "running": {
                        "color": "blue",
                        "index": 4
                      },
                      "evaluating": {
                        "color": "blue",
                        "index": 5
                      },
                      "submitted": {
                        "color": "yellow",
                        "index": 6
                      },
                      "pending": {
                        "color": "text",
                        "index": 7
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "workflow"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Task logs (Loki)",
                    "url": "/explore?left={\"datasource\":\"tevv-loki\",\"queries\":[{\"refId\":\"A\",\"expr\":\"{namespace=\\\"default\\\"} | workflow_id=\\\"${__value.raw}\\\"\"}],\"range\":{\"from\":\"now-7d\",\"to\":\"now\"}}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Gates per run",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tevv-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tevv-registry"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT g.campaign_id AS campaign, g.run_key AS run, g.gate,\n       round(g.value::numeric, 3) AS value, g.bound::text AS bound,\n       CASE WHEN g.passed THEN 'pass' ELSE 'fail' END AS result, g.detail\nFROM gate_results g JOIN v_latest_runs r USING (campaign_id, run_key, attempt)\nWHERE g.campaign_id IN (${campaign:sqlstring}) ORDER BY 1, 2, 3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pass": {
                        "color": "green",
                        "index": 0
                      },
                      "fail": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "ATE rmse per run (m)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tevv-registry"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tevv-registry"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT m.campaign_id || ' / ' || m.run_key AS run, m.value AS \"ATE rmse m\"\nFROM metrics_summary m JOIN v_latest_runs r USING (campaign_id, run_key, attempt)\nWHERE m.campaign_id IN (${campaign:sqlstring}) AND m.metric = 'ate_rmse_m' ORDER BY 1"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Attempts finished per day, by status",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tevv-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tevv-registry"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', ended_at) AS time, status, count(*) AS runs\nFROM runs WHERE campaign_id IN (${campaign:sqlstring}) AND ended_at IS NOT NULL AND $__timeFilter(ended_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    }
  ]
}