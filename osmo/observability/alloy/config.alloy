// Grafana Alloy on each kind node: every OSMO task's output, and the OSMO
// control plane's, into Loki. Installed by observability/install.sh.
//
// Where a task's output is. OSMO runs a task's command under osmo_exec, which
// re-emits its stdout and stderr on the container's stderr with a
// "YYYY/MM/DD HH:MM:SS " prefix, so the node's container log holds all of it:
// a 20,000-line burst arrived here whole, where `osmo workflow logs` returned
// about half. Pods are deleted seconds after their task ends, and their log
// files with them, so this reads live; nothing reaches back for a finished run.
//
// Labels. Indexed: namespace, job, task, source -- a few dozen streams. The
// workflow and pod ride as structured metadata, so a run is found with
//   {job="osmo/workflow", task="verdict"} | workflow_id="sim-bridge-vio-63"
// and the run registry maps workflow_id to campaign, run key and attempt.

// This node's pods only: each Alloy reads its own node's files.
discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["default", "osmo"]
  }
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  // In `default`, only OSMO workflow pods.
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_osmo_workflow_id"]
    regex         = "default;"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "default"
    replacement   = "osmo/workflow"
    target_label  = "job"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "osmo"
    replacement   = "osmo/control-plane"
    target_label  = "job"
  }
  // task: the workflow's task name, or the control-plane component.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_osmo_task_name"]
    target_label  = "task"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_app"]
    regex         = "osmo;(.+)"
    target_label  = "task"
  }
  // source: the task's own output, OSMO's sidecar, or the control plane.
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    regex         = ".*"
    replacement   = "task"
    target_label  = "source"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    regex         = "osmo-ctrl|osmo-init"
    replacement   = "sidecar"
    target_label  = "source"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "osmo"
    replacement   = "control-plane"
    target_label  = "source"
  }
  // Moved to structured metadata below, then dropped as labels.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_osmo_workflow_id"]
    target_label  = "workflow_id"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    replacement   = "/var/log/pods/*$1/*.log"
    target_label  = "__path__"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  // The container runtime's line format: timestamp, stream, flag, message.
  stage.cri {}

  // osmo_exec's second-resolution prefix; the runtime's timestamp is kept.
  stage.match {
    selector = "{source=\"task\"}"
    stage.regex {
      expression = "^\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2} (?P<message>.*)$"
    }
    stage.output {
      source = "message"
    }
  }

  stage.structured_metadata {
    values = {
      workflow_id = "",
      pod         = "",
    }
  }
  stage.label_drop {
    values = ["workflow_id", "pod", "filename"]
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki.tevv.svc:3100/loki/api/v1/push"
  }
}
