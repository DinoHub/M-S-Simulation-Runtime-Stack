<mxfile>
  <diagram name="system-architecture">
    <mxGraphModel dx="1650" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="TP" value="Trigger plane — outside cluster" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;container=1;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="1200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="GHA" value="GitHub Actions (self-hosted runners)&lt;br/&gt;build + push images, unit tests, fire webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="TP">
          <mxGeometry x="20" y="40" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="CLI" value="tevv CLI&lt;br/&gt;dev-initiated runs and sweeps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="TP">
          <mxGeometry x="320" y="40" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="CRON" value="cron&lt;br/&gt;nightly L2/L3 matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="TP">
          <mxGeometry x="620" y="40" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="DEV" value="Dev workstation&lt;br/&gt;compose stack — manual path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="TP">
          <mxGeometry x="920" y="40" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="HARBOR" value="Harbor registry&lt;br/&gt;Trivy scan + syft SBOM + cosign sign" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="OP" value="Orchestration plane" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;container=1;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="1200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="AE" value="Argo Events&lt;br/&gt;one webhook EventSource, per-tier Sensors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="OP">
          <mxGeometry x="20" y="40" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="AW" value="Argo Workflows&lt;br/&gt;WorkflowTemplate per tier&lt;br/&gt;partitioned semaphores: gpu-sim-interactive=1, gpu-sim-batch=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="OP">
          <mxGeometry x="320" y="40" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OC" value="omega-compile step&lt;br/&gt;tevv-compile container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="OP">
          <mxGeometry x="620" y="40" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COND" value="run-conductor step, one per run&lt;br/&gt;K8s client: creates namespace, applies bundle,&lt;br/&gt;go-barrier, watchdog, teardown — exit code = step outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="OP">
          <mxGeometry x="920" y="40" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="RP" value="Run plane — namespace tevv-run-&amp;lt;run_id&amp;gt; per run" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;container=1;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="1200" height="260" as="geometry" />
        </mxCell>
        <mxCell id="SIM" value="sim adapter (GPU node)&lt;br/&gt;UE5 + Cosys-AirSim | Isaac + Pegasus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="RP">
          <mxGeometry x="20" y="40" width="260" height="90" as="geometry" />
        </mxCell>
