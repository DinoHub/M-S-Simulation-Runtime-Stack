        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="GEN" target="EXEC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="docker compose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="BCOMP" target="HOSTSTACK">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="747" y="440" /><mxPoint x="190" y="440" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="submit WorkflowTemplate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="BARGO" target="ARGO">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="952" y="455" /><mxPoint x="540" y="455" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e9" value="admit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="ARGO" target="KUEUE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="start run pod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.152;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ARGO" target="POD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="/out -&gt; artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.66;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="POD" target="S_S3">
