          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="artifact in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.08;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_S3" target="EVAL">
