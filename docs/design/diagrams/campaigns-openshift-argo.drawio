        <mxCell id="e16" value="mirror images" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.51;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="AG" target="IREG">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="pods, logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;exitX=0.837;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="POD" target="LOGS">
          <mxGeometry relative="1" as="geometry" />
