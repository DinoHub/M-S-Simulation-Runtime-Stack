      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="run-workflow" id="run">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="r0" />
        <mxCell id="r1" parent="r0" />

        <mxCell id="WT" value="WorkflowTemplate tevv-campaign-run — one Workflow per run (variant x seed x repeat)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;container=1;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="r1">
          <mxGeometry x="40" y="40" width="1520" height="560" as="geometry" />
        </mxCell>
        <mxCell id="PAR" value="&lt;b&gt;Parameters&lt;/b&gt;&lt;br/&gt;campaign, run_key, scenario (materialised ScenarioSpec),&lt;br/&gt;image refs (digests), autopilot, route, gates, fly, viz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;align=left;spacingLeft=8;" vertex="1" parent="WT">
          <mxGeometry x="20" y="40" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="&lt;b&gt;1. generate&lt;/b&gt;&lt;br/&gt;stackgen: ScenarioSpec -&amp;gt; stack config&lt;br/&gt;output artifact: cfg.tgz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="WT">
          <mxGeometry x="20" y="170" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="&lt;b&gt;2. fly&lt;/b&gt; (containerSet, GPU)&lt;br/&gt;sim, bridge, autopilot, component,&lt;br/&gt;pilot, recorder (lead), foxglove&lt;br/&gt;output artifact: bag + logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="WT">
          <mxGeometry x="340" y="170" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S3a" value="&lt;b&gt;3a. validate-recording&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="WT">
          <mxGeometry x="720" y="140" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="S3b" value="&lt;b&gt;3b. performance eval&lt;/b&gt; (sim-real-eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="WT">
          <mxGeometry x="720" y="200" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="S3c" value="&lt;b&gt;3c. safety eval&lt;/b&gt; (new)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="WT">
          <mxGeometry x="720" y="260" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="&lt;b&gt;4. verdict&lt;/b&gt;&lt;br/&gt;gates from the CampaignSpec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="WT">
