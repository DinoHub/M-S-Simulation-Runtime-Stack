%% TEVV on OSMO, as built (4 Oct 2026): from getting onto OSMO, through a
%% CampaignSpec, to one gang-scheduled workflow per run, the scorecard, the run
%% registry and the logs. Grey dashed: built for local compose runs, not yet
%% carried into the OSMO workflow (target only).
%% Sources: docs/osmo-runbook.md, docs/osmo-kubernetes-concepts.md, docs/osmo-logs.md,
%% osmo/campaign.py, osmo/sim-bridge-vio.workflow.yaml, osmo/observability/install.sh.
%% Render (from this folder):
%%   docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD:/data" minlag/mermaid-cli \
%%     -p /puppeteer-config.json -i /data/osmo-end-to-end.mermaid -o /data/osmo-end-to-end.png -s 2
flowchart TB
  subgraph ONB["1. Onboarding, once"]
    direction LR
    W1["Workstation<br/>NVIDIA runtime as docker default<br/>kind, kubectl, helm, osmo CLIs"]
    W2["osmo/setup-local-osmo.sh gpu<br/>kind cluster, KAI scheduler,<br/>GPU operator, OSMO 6.3.1"]
    W3["osmo login + 3 configs<br/>POOL mounts /workspace<br/>WORKFLOW registry check off<br/>POD_TEMPLATE IfNotPresent"]
    W4["Images onto the GPU node<br/>kind load docker-image<br/>campaign.py images: all ok"]
    W1 --> W2 --> W3 --> W4
  end

  subgraph AUTH["2. Authoring, in git"]
    direction LR
    CS["CampaignSpec<br/>variants, repeats, seeds,<br/>mission route, gates"]
    SS["ScenarioSpec<br/>level, vehicle, rig,<br/>weather, estimator"]
    CAT["images/catalog.yaml<br/>digest-pinned image set"]
    CS -->|"scenario:"| SS
  end

  subgraph HOST["3. Per campaign, on the host: osmo/campaign.py run"]
    direction LR
    PLAN["mns-stacks campaign plan --json<br/>one merged ScenarioSpec per run"]
    GEN["mns-stacks generate<br/>stacks/run/config: settings.json,<br/>host-launch-args.json, topics,<br/>conditions, estimator"]
    IMG["image check<br/>catalog digest = node image"]
    SUB["osmo workflow submit, one per run<br/>--set stack, autopilot, viz<br/>--set-string route, gates, images"]
    PLAN --> GEN --> IMG --> SUB
  end

  subgraph CP["4. OSMO control plane, namespace osmo"]
    direction LR
    API["API server + gateway<br/>submit, query, logs"]
    ENG["workflow engine<br/>groups, retries, exit codes"]
    S3["object storage<br/>task outputs"]
    API --> ENG
  end

  subgraph NODE["5. GPU node: one gang per run"]
    direction LR
    KAI["KAI scheduler<br/>whole group or nothing"]
    RUN["group run<br/>discovery server, sim UE 5.8 + AirSim,<br/>autopilot PX4 or ArduPilot,<br/>bridge + MAVROS, OpenVINS, pilot,<br/>recorder (lead), foxglove (optional)"]
    EVAL["group evaluate<br/>vio-eval, spawn-eval, validate"]
    AGG["group aggregate<br/>verdict against the gates"]
    KAI --> RUN --> EVAL --> AGG
  end

  subgraph OUT["6. Results, on the host"]
    direction LR
    PULL["runs/run: bag, mission.json,<br/>eval, run.json with images"]
    VS["vio-stress: reports/run"]
    MAN["campaign_manifest.json<br/>campaign status, dashboard"]
    WATCH["campaign.py watch<br/>Foxglove at node:30765"]
    PULL --> VS --> MAN
  end

  subgraph OBS["7. Observability: osmo/observability"]
    direction LR
    REG["run registry<br/>Postgres (CNPG), namespace tevv<br/>campaign.py registry sync"]
    LOKI["Loki + Alloy<br/>every task and the control plane,<br/>by workflow, :31100, 30 days"]
    GRAF["the host's Grafana :3000<br/>TEVV campaign progress,<br/>TEVV run logs"]
    REG --> GRAF
    LOKI --> GRAF
  end

  GAP["not yet under OSMO:<br/>attached component packages,<br/>the metrics service's verdict per run"]

  ONB -->|"cluster ready, images loaded"| HOST
  AUTH -->|"specs + image pins"| HOST
  HOST -->|"one workflow per run"| CP
  CP -->|"gang per run"| NODE
  NODE -->|"evidence in object storage"| OUT
  HOST -->|"status as it flies, verdict"| REG
  NODE -->|"container logs"| LOKI
  NODE -.-> GAP

  classDef target fill:#F1F1EE,stroke:#8A8F99,color:#4A5160,stroke-dasharray:6 4
  class GAP target
