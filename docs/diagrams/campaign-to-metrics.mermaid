%% TEVV: from a CampaignSpec to a verdict per run, stored and shown.
%% State as of 4 Oct 2026. Three states, by style:
%%   built       green, solid  - runs today (compose: make campaign or the dashboard; OSMO: osmo/campaign.py)
%%   exists      amber, solid  - built and running elsewhere, not connected to campaign runs
%%   target      grey, dashed  - designed (docs/platform-architecture), not built
%% Sources: mns_stacks/campaign.py, director.py, scoring.py, lifecycle.py (MnS-Integration-Platform
%% platform/stacks, branch feat/components), docker-compose-dashboard.yml (metrics-service),
%% TEVV-Web-Dashboard Campaign step (branch feat/live-stack-viewer), osmo/campaign.py.
%% Render (from this folder):
%%   docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD:/data" minlag/mermaid-cli \
%%     -p /puppeteer-config.json -i /data/campaign-to-metrics.mermaid -o /data/campaign-to-metrics.png -s 2
flowchart TB
  subgraph SPEC["1. The spec"]
    direction LR
    CS["CampaignSpec<br/>variants, seeds, repeats, mission,<br/>mission.start, end_on_timeout,<br/>extensions.mns.components"]
    DASHC["dashboard Campaign step<br/>authors the CampaignSpec, Run campaign"]
    SS["ScenarioSpec<br/>level, vehicle, rig, weather"]
    COMP["components/id/component.yaml<br/>attached outside the ScenarioSpec"]
    DASHC -->|"writes"| CS
    CS -->|"scenario:"| SS
  end

  subgraph RUNNER["2. mns-stacks campaign run (make campaign, or the dashboard backend)"]
    direction LR
    VAL["validate + preflight<br/>schema, route, start and end,<br/>disk, ports, images"]
    LOCK["campaign.lock<br/>one campaign at a time"]
    VAL --> LOCK
  end

  subgraph PERRUN["3. Per run"]
    direction LR
    MAT["materialize<br/>one ScenarioSpec<br/>for the variant"]
    GEN["generate<br/>stack + components<br/>and their adaptors"]
    DIR["run director<br/>WAIT_HEALTHY, WAIT_READY,<br/>warm-up, start delay,<br/>mission, end condition"]
    STOP["stop<br/>finalize_metrics,<br/>compose down"]
    SCORE["score each component<br/>built-in or own image<br/>components/id.json"]
    MAT --> GEN --> DIR --> STOP --> SCORE
  end

  subgraph JUDGE["4. Judged"]
    direction LR
    MS["metrics service :8770<br/>events.jsonl + component results<br/>vs the stack's evaluation.yaml, zones.json"]
    EVAL["campaign evaluator<br/>after the matrix<br/>reports/run.json"]
    MAN["campaign_manifest.json<br/>progress.jsonl"]
  end

  subgraph SHOW["5. Shown"]
    direction LR
    PROG["dashboard Campaign step<br/>progress table, verdict per run"]
    RM["dashboard Monitor<br/>Run metrics"]
    STAT["campaign status<br/>scorecard, CLI"]
  end

  subgraph OSMO["The same CampaignSpec on OSMO: osmo/campaign.py"]
    direction LR
    OPLAN["campaign plan + generate<br/>in the mns-stacks image"]
    OWF["one workflow per run<br/>run, evaluate, aggregate (verdict)"]
    OREG["run registry (Postgres)<br/>Loki + Alloy logs, Grafana"]
    OGAP["component packages and<br/>the metrics service under OSMO"]
    OPLAN --> OWF --> OREG
  end

  KAF["Kafka, ClickHouse, Grafana<br/>metrics_kafka_bridge, outside the product,<br/>not part of the campaign flow"]

  CS --> VAL
  COMP -->|"--component"| GEN
  LOCK --> MAT
  SCORE --> MS
  STOP -->|"events.jsonl"| MS
  STOP -->|"bag + ground truth"| EVAL
  GEN -.->|"run.generated, run.flying"| MAN
  EVAL --> MAN
  MS --> PROG
  MS --> RM
  MAN --> PROG
  MAN --> STAT
  CS -.-> OPLAN
  OWF -->|"evidence pulled back"| MAN
  OWF -.-> OGAP

  classDef built fill:#DCEFE2,stroke:#2E7D4F,color:#14213D
  classDef exists fill:#FBEBD2,stroke:#B4501E,color:#14213D
  classDef target fill:#F1F1EE,stroke:#8A8F99,color:#4A5160,stroke-dasharray:6 4
  class CS,DASHC,SS,COMP,VAL,LOCK,MAT,GEN,DIR,STOP,SCORE,MS,EVAL,MAN,PROG,RM,STAT,OPLAN,OWF,OREG built
  class KAF exists
  class OGAP target
