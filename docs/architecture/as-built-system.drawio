<mxfile host="Electron" type="device"><diagram id="mns-as-built" name="As built"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="1176" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c90" value="Where a campaign runs" style="swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1920" y="70" width="340" height="1032" as="geometry"/></mxCell><mxCell id="c89" value="Judge and report" style="swimlane;startSize=30;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1540" y="70" width="340" height="1032" as="geometry"/></mxCell><mxCell id="c88" value="A generated stack: generated/&amp;lt;name&amp;gt;/" style="swimlane;startSize=30;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="340" height="1032" as="geometry"/></mxCell><mxCell id="c87" value="Platform: the mns-stacks image" style="swimlane;startSize=30;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="340" height="1032" as="geometry"/></mxCell><mxCell id="c86" value="You and the product shell (this repository)" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="340" height="1032" as="geometry"/></mxCell><mxCell id="c85" value="Dashboard: make dashboard" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="340" height="1032" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;dashboard-frontend&lt;/b&gt; :3001&lt;br&gt;the scenario wizard:&lt;br&gt;0 Content · 1a Author · 1b Generate&lt;br&gt;1c ROS 2 · 1d Metrics · &lt;b&gt;1e Campaign&lt;/b&gt;&lt;br&gt;2 Run · 3 Analysis&lt;br&gt;Monitor: Run events, Run metrics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="110" width="316" height="102" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Campaign step&lt;/b&gt; (1e)&lt;br&gt;components under test, the mission,&lt;br&gt;start (steady streams, then a delay) and end,&lt;br&gt;sweeps × seeds × repeats,&lt;br&gt;what each run is judged on&lt;br&gt;→ a CampaignSpec; Run campaign&lt;br&gt;→ one progress row per run, with its verdict" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="226" width="316" height="117" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;dashboard-backend&lt;/b&gt; :8001 (FastAPI)&lt;br&gt;docker.sock: runs mns-stacks, mns-packs&lt;br&gt;and ScenarioLab as sibling containers;&lt;br&gt;imports no platform code&lt;br&gt;/api/campaign/* · /api/metrics (→ :8770)" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="357" width="316" height="87" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ros2-tools&lt;/b&gt; (created by the backend)&lt;br&gt;the bridge image, on the stack's ROS domain:&lt;br&gt;Foxglove websocket :8764, bag replay" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="458" width="316" height="57" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;dashboard-lichtblick&lt;/b&gt; :8082&lt;br&gt;the topic viewer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="529" width="316" height="42" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;postgres-telemetry&lt;/b&gt; (TimescaleDB)&lt;br&gt;only with make dashboard DB=true" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="585" width="316" height="42" as="geometry"/></mxCell><mxCell id="c9" value="The Campaign step, and the Run step that replaces Launch and Runtime, are on the dashboard branch feat/live-stack-viewer and run from local images (tevv-web-dashboard-*-v1.0.0-live.8 and later). The catalog still pins the release/v1.0.0-next build: 2 Launch, 3 Runtime, 4 Analysis, no Campaign step." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="32" y="641" width="316" height="84" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;You&lt;/b&gt;: a browser on http://localhost:3001,&lt;br&gt;or a terminal in this checkout" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="110" width="316" height="42" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;make&lt;/b&gt; (Makefile)&lt;br&gt;dashboard · dashboard-down&lt;br&gt;fly (RECORD=1, KEEP=1) · evaluate · stop&lt;br&gt;campaign · campaign-status&lt;br&gt;author · stacks · topics&lt;br&gt;doctor · ensure-images · verify-images" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="166" width="316" height="102" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;tools/&lt;/b&gt;&lt;br&gt;fly.sh · evaluate.sh: generate, wait for the&lt;br&gt;components, record, fly, stop, the verdict&lt;br&gt;mns-stacks.sh: mns-stacks as a sibling&lt;br&gt;container, host paths mounted&lt;br&gt;images.sh sync · verify · bump" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="282" width="316" height="102" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;scenarios/&amp;lt;name&amp;gt;/&lt;/b&gt;&lt;br&gt;ScenarioSpec.yaml (+ includes)&lt;br&gt;CampaignSpec.yaml · routes/" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="398" width="316" height="57" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;components/&amp;lt;id&amp;gt;/component.yaml&lt;/b&gt;&lt;br&gt;consumes · produces · ready · services&lt;br&gt;scoring · latency&lt;br&gt;estimators: mac-vo, openvins&lt;br&gt;planners: mighty, super&lt;br&gt;perception: casio-edge&lt;br&gt;camera realism: siyi-a8-realism" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="469" width="316" height="117" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ScenarioLab&lt;/b&gt; (the authoring image)&lt;br&gt;the Unreal editor on your X display;&lt;br&gt;exports a ScenarioSpec" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="600" width="316" height="57" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;images/catalog.yaml&lt;/b&gt;&lt;br&gt;one image catalog: Docker Hub&lt;br&gt;dhdevspace/auto_mns, tag + digest&lt;br&gt;→ images/*.generated.env, image sets&lt;br&gt;→ a generated stack's .env pins" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="671" width="316" height="87" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;packs/v1.0.0.lock.json&lt;/b&gt;&lt;br&gt;level and object pack versions" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="772" width="316" height="42" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;.mns/v1/pack-store/&lt;/b&gt;&lt;br&gt;installed by mns-packs (download-packs.sh,&lt;br&gt;the Content step); mounted into the&lt;br&gt;runtime host and ScenarioLab" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="412" y="828" width="316" height="72" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;mns-stacks&lt;/b&gt; (cli.py): one command per container&lt;br&gt;generate · run · stop · record · score&lt;br&gt;report · campaign · component · status" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="792" y="110" width="316" height="57" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;campaign&lt;/b&gt; (campaign.py)&lt;br&gt;init · validate · preflight · plan · run&lt;br&gt;status · watch · cancel&lt;br&gt;per run: materialize a ScenarioSpec,&lt;br&gt;generate it with its components,&lt;br&gt;fly it (run --until-done), stop&lt;br&gt;then the campaign's evaluator&lt;br&gt;→ campaign_manifest.json, progress.jsonl" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="181" width="316" height="132" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;generate&lt;/b&gt; (stackgen)&lt;br&gt;the ScenarioSpec + image set + pack store&lt;br&gt;&lt;b&gt;components.py&lt;/b&gt;: attach --component packages,&lt;br&gt;outside the ScenarioSpec, with adaptors&lt;br&gt;&lt;b&gt;evaluation_catalog.yaml&lt;/b&gt;: what runs are&lt;br&gt;judged on&lt;br&gt;&lt;b&gt;metrics_catalog.yaml&lt;/b&gt;: simulator detectors&lt;br&gt;&lt;b&gt;zones.py&lt;/b&gt;: keep-out, keep-in, coverage" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="327" width="316" height="132" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;run --until-done&lt;/b&gt;: the run director" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="792" y="473" width="316" height="27" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;director.py&lt;/b&gt; states&lt;br&gt;VALIDATE → STACK_UP&lt;br&gt;→ WAIT_HEALTHY: the simulator healthcheck&lt;br&gt;→ &lt;b&gt;WAIT_READY&lt;/b&gt;: each component's ready topics&lt;br&gt;→ RECORD_START: warm-up until streams&lt;br&gt;are steady, then record (--topics @scoring)&lt;br&gt;→ MISSION_START: start delay, then a QGC&lt;br&gt;plan, an external start-cmd, or none&lt;br&gt;→ WAIT_DONE: landed · topic · event · timeout&lt;br&gt;→ RECORD_STOP → HANDOFF → TEARDOWN" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="514" width="316" height="162" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;record start | stop&lt;/b&gt; (recorder.py)&lt;br&gt;ros2 bag record inside the bridge container;&lt;br&gt;SIGINT, so rosbag2 writes metadata.yaml" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="690" width="316" height="57" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;stop&lt;/b&gt; (lifecycle.py)&lt;br&gt;graceful simulator stop, finalize_metrics,&lt;br&gt;compose down, the run's metrics copied" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="761" width="316" height="57" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;score&lt;/b&gt; (scoring.py), each attached component&lt;br&gt;built in: estimate (ATE, RPE, drift),&lt;br&gt;planner (goals, clearance, jerk), latency&lt;br&gt;(input to output, from the bag),&lt;br&gt;or the component's own scorer image" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="832" width="316" height="87" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;report&lt;/b&gt;: the verdict table&lt;br&gt;&lt;b&gt;campaign status&lt;/b&gt;: the scorecard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="792" y="933" width="316" height="42" as="geometry"/></mxCell><mxCell id="c28" value="Component attach, WAIT_READY, scoring and the campaign's start and end conditions are on the platform branch feat/components and run from local mns-stacks-v1.0.0-rc.services.N images; the catalog pins mns-stacks-v1.0.0-rc." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="792" y="989" width="316" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;docker-compose.yml&lt;/b&gt;, &lt;b&gt;.env&lt;/b&gt; (image pins,&lt;br&gt;MNS_METRICS_ARGS)&lt;br&gt;config/stack/contract.json (topic roles)&lt;br&gt;config/metrics/evaluation.yaml, zones.json&lt;br&gt;config/topic_names.yaml&lt;br&gt;generated-manifest.json" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1172" y="110" width="316" height="102" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;unreal-airsim&lt;/b&gt;: the runtime host&lt;br&gt;Unreal Engine 5.8 + Cosys-AirSim&lt;br&gt;MetricsEmitter plugin: pose, collisions,&lt;br&gt;clearance, zones, run.ended" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1172" y="514" width="316" height="72" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;px4-drone-N&lt;/b&gt; or &lt;b&gt;ardupilot-drone-N&lt;/b&gt;&lt;br&gt;autopilot SITL, one per vehicle" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1172" y="600" width="316" height="42" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;airsim_bridge_&amp;lt;vehicle&amp;gt;&lt;/b&gt;&lt;br&gt;the ROS 2 bridge, with MAVROS;&lt;br&gt;the recorder runs here" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1172" y="656" width="316" height="57" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;foxglove_bridge_&amp;lt;vehicle&amp;gt;&lt;/b&gt; :8765 and up&lt;br&gt;&lt;b&gt;iceoryx-init&lt;/b&gt;: camera shared memory" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1172" y="727" width="316" height="42" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;component services&lt;/b&gt; &amp;lt;id&amp;gt;_&amp;lt;service&amp;gt;&lt;br&gt;from component.yaml, with adaptors:&lt;br&gt;mac_vo_{config, macvo, adaptor}&lt;br&gt;openvins_ov_msckf · mighty_planner&lt;br&gt;super_planner · casio_edge_*&lt;br&gt;siyi_a8_realism_realism" style="shape=process;size=0.035;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=16;spacingRight=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1172" y="783" width="316" height="102" as="geometry"/></mxCell><mxCell id="c35" value="optional: qgroundcontrol-x11,&lt;br&gt;sim-real-eval-worker" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeCo