# =========================================================
# MnS product settings (./setup.sh copies this file to .env)
# =========================================================
# Everything is optional: the values shown are the defaults used when a key
# is unset. Uncomment a line to change it. docker compose reads this file.
#
# Leave image variables (*_IMAGE) OUT of this file unless you deliberately
# run a local build: any image key set here overrides the release pins.
#
# Where recorded runs and rosbags are written (one folder per run). Default:
# runs/ inside this checkout. Use an absolute path to put them elsewhere.
# TEVV_RUNS_DIR=/path/to/runs
#
# X11 display for ScenarioLab and the simulator window. Normally leave it
# alone: a desktop terminal exports DISPLAY, and `make dashboard` finds the
# XAUTHORITY cookie itself. Set DISPLAY only when starting over SSH.
# DISPLAY=:0
#
# Docker config holding your `docker login` (only if it is not ~/.docker).
# DOCKER_CONFIG=~/.docker
#
# Host ports, if the defaults clash with something else on this machine.
# DASHBOARD_LICHTBLICK_PORT=8082
# FOXGLOVE_BRIDGE_PORT=8764
#
# Grafana dashboard embedded in the Monitor page's Grafana tab. MnS ships no
# Grafana: point this at your own, or leave it (the tab says "not reachable").
# GRAFANA_URL=http://localhost:3000/d/metrics-robotics/robotics-telemetry?kiosk
#
# Image pulls: `missing` uses what is cached; `always` re-checks the registry.
# DASHBOARD_PULL_POLICY=missing
# MNS_IMAGE_PULL_POLICY=missing
#
# Not read from this file — pass these on the make command line or export them:
#   make dashboard CHANNEL=ue582|v1|v2 IMAGE_MODE=development|production DB=true
#   make dashboard MNS_DEMO_PACKS=--all      # also install missing packs first
#   ./download-packs.sh --list              # content packs: see, then download
#   export GH_TOKEN=...                      # pack downloads (or: gh auth login)
#   export MNS_DEMO_PACK_DOWNLOAD_DIR=/big/disk/tmp
#
# Telemetry database (make dashboard DB=true only).
# POSTGRES_DB=drone_telemetry
# POSTGRES_USER=airsim_user
# POSTGRES_PASSWORD=dashboard_local_only
