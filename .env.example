# =========================================================
# Scenario shape (consumed by tools/generate_scenario.py)
# =========================================================
# These keys are the SINGLE SOURCE OF TRUTH for ardupilot-xfs scenario
# shape. tools/generate_scenario.py reads them and renders the production
# compose + settings.json from compose/ardupilot-xfs/templates/. Edit and
# either run the generator explicitly or just `./launch.sh ardupilot-xfs`
# (the launcher detects drift and regenerates).

NUM_DRONES=9
VEHICLE_PREFIX=Copter
DRONE_X_SPACING_M=8                # X offset between consecutive vehicles (settings.json)
MAVLINK_PORT_BASE=5760             # SITL N -> MAVLink TCP base + N*stride
MAVLINK_PORT_STRIDE=10
FDM_TCP_PORT_BASE=9002             # ArduPilot <-> AirSim FDM TCP base
FDM_UDP_PORT_BASE=9003
FDM_PORT_STRIDE=10
AGENT_INTERNAL_SUBNET_BASE=172.28  # /24 prefix for agent_internal-{1..N}

# =========================================================
# Docker Images (required)
# =========================================================
# Container images used by the simulation stack.
# These must exist locally or be pullable from a registry.

# ardupilot-slim has the per-instance SERIAL port offset baked in
# (run_ardupilot_airsim.sh). The older :ardupilot-latest tag does NOT, and
# multi-drone scenarios (ardupilot-xfs) will hit "bind failed on port 5762".
ARDUPILOT_IMAGE=dhdevspace/auto_mns:ardupilot-slim
AIRSIM_IMAGE=dhdevspace/auto_mns:xfs-latest
ROS2_IMAGE=dhdevspace/auto_mns:airsim-ros2-bridge
# Registry default lacks the C2 endpoint + MAVROS Server(:14555) router
# template. For those, build the local overlay and point this at it, e.g.
#   PX4_IMAGE=local/auto_mns:px4-airsim-px4-c2
# (px4 services use pull_policy: if_not_present so a local-only tag is kept.)
PX4_IMAGE=dhdevspace/auto_mns:px4-airsim-px4

# AIRSIM_BRIDGE_IMAGE is the per-drone airsim_bridge_dN image used by the
# default ardupilot-xfs flow. Defaults to the multi-agent-bridge tag baked
# from feat/multi-agent-ros2-zenoh-architecture (Cosys-AirSim PR #42), which
# adds the local_obs_target_frame toggle and clock-master pattern.
# Override only if you need to pin a specific tag for a regression test.
# TEMP (rtabmap test): repointed to the local build w/ RTAB-Map backend + LiDAR
# dedup. Revert to dhdevspace/auto_mns:airsim-ros2-bridge after testing.
AIRSIM_BRIDGE_IMAGE=tevv-airsim-ros2-bridge:humble

# ============================================================================
# DDS transport (px4-safticity)
# ============================================================================
# DEFAULT: CycloneDDS bound to loopback (config/cyclonedds/cyclonedds-local.xml).
# The whole local graph (airsim_bridge_d1 + mavros_d1 + registration tuner) runs
# one Cyclone domain on lo. The Cyclone-based zenoh bridge (make zenoh-up, TEVV
# repo) reads it natively and ships the registered cloud cross-host to the Orin
# over zenoh TCP — cross-host is NOT direct cyclone, so per-host DDS stays on lo.
#
# CROSS-HOST to the Orin — two options:
#  (a) Zenoh bridge  — local transport stays loopback (default); `make zenoh-up`
#      in the TEVV repo ships the registered cloud over zenoh TCP. Best for lossy
#      / wireless links. Set ROS_DOMAIN_ID to match the Orin.
#  (b) DIRECT CycloneDDS over Ethernet (opt-in below) — one Cyclone graph across
#      both hosts via unicast peers; simpler, no zenoh hop, best on a WIRED NIC.
#      Uncomment + set your NIC/IPs. Prereqs: the Orin runs a matching cyclone
#      config (same peers, domain 42); BOTH hosts run the TEVV repo's
#      scripts/setup-host.sh (rmem_max/wmem_max>=16MB); do NOT also run zenoh.
#      cyclonedds-sim.xml reads these three vars via ${VAR} expansion.
# # --- direct-cyclone-over-ethernet (opt-in) ---
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp     # already the default
# CYCLONEDDS_URI=file:///cfg/cyclonedds-sim.xml
# ROS_DOMAIN_ID=42                          # must match the Orin
# CYCLONE_IFACE=enp14s0                     # this host's Ethernet NIC (ip -br link)
# SIM_HOST_IP=192.168.100.101               # this host on that NIC
# ORIN_IP=192.168.100.167                   # the Orin on that NIC
#
# To force FastDDS-UDP instead — e.g. to inspect the graph from a host-shell
# `ros2 topic echo` (defaults to rmw_fastrtps) — set ONE knob:
#   RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# The UDP-only profile (config/fastdds/fastdds-udp-only.xml) is always mounted and
# auto-applies. Advanced: BRIDGE_FASTDDS_PROFILE, CYCLONEDDS_URI. ROS_DOMAIN_ID
# defaults to 0 (loopback); set it to match the Orin for either cross-host path.

# TEMP (rtabmap test): drive the new registration backend. ground_truth/gt =
# original behaviour. Remove these two lines (and the compose arg lines) to revert.
REGISTRATION_SOURCE=rtabmap
RTABMAP_ODOMETRY=gt
# LiDAR generation toggle. One knob drives BOTH the sim settings.json SensorType
# (6 CPU / 8 GPU) and the registration backend's input topic. Regenerate after
# changing: python3 tools/generate_scenario.py --scenario px4-condo
#   lidar    -> CPU LiDAR (SensorType 6), topic LidarSensor1/points
#   gpulidar -> GPU LiDAR (SensorType 8), topic gpulidar/pointsLidarSensor1
# WARNING: gpulidar segfaults the condo-latest AirSim build (RealtimeGPUProfiler
# IsInGameThread assertion); use only on a GPU-lidar-capable sim.
LIDAR_KIND=gpulidar
# Optional hard override of just the bridge input topic (normally derived from
# LIDAR_KIND above; leave unset unless you need a non-default topic):
# LIDAR_TOPIC_SUFFIX=LidarSensor1/points

# zenoh-bridge-ros2dds image used by the sim-side router (ardupilot-xfs).
ZENOH_BRIDGE_IMAGE=eclipse/zenoh-bridge-ros2dds:1.4.0

# =========================================================
# Scenario Selection
# =========================================================
# Selects which compose/<scenario>/docker-compose.yml is used by launch.sh.
# Available scenarios:
#   px4-condo       PX4 SITL + AirSim Condo (single drone, default)
#   px4-xfs         PX4 SITL x4 + AirSim XFS (multi-drone swarm)
#   ardupilot-condo ArduPilot SITL + AirSim Condo (single drone)
#   ardupilot-xfs   ArduPilot SITL x4 + AirSim XFS (multi-drone swarm)
#
# Override on the command line:
#   ./launch.sh ardupilot-condo

SCENARIO=px4-condo


# =========================================================
# Editor mode + autopilot home (optional)
# =========================================================
# EDITOR_MODE=true (or --editor) skips the containerized AirSim (the `sim`
# compose profile) so you run AirSim from the Unreal editor on the host. The
# rest of the stack (SITL, bridges, mavros, QGroundControl) still starts and
# connects to the editor's RPC on localhost:41451 (host networking). The
# launcher BLOCKS until that RPC is listening — Play the level in the editor —
# before starting the bridges, which query RPC once with no retry.
# EDITOR_RPC_TIMEOUT bounds that wait (seconds; 0 = wait forever).
# EDITOR_MODE=false
# EDITOR_RPC_TIMEOUT=180

# Autopilot home / EKF origin. SEPARATE from AirSim settings.json
# OriginGeopoint (which is the runtime GPS source); keep these EQUAL to the
# OriginGeopoint of the terrain you fly or the EKF origin jumps when GPS
# arrives. Interpolated at compose-up (not generator inputs) — restart only,
# no regen. Defaults below are an Idaho test coordinate, NOT the Singapore
# terrains — set them when you change map or run --editor.
# PX4_HOME_LAT=1.3738003
# PX4_HOME_LON=103.677839
# PX4_HOME_ALT=16.0
# ARDUPILOT_HOME_LAT=1.3738003
# ARDUPILOT_HOME_LON=103.677839
# ARDUPILOT_HOME_ALT=16.0


# =========================================================
# Cross-cutting stacks (opt-in)
# =========================================================
# launch.sh starts the simulation only by default. Set these to true to
# also bring up the monitoring (Prometheus/Grafana/Elasticsearch/exporters)
# and metrics (collector + supervisor) stacks.
# CLI flags --with-monitoring / --with-metrics / --all override these.

START_MONITORING=true
START_METRICS=true


# =========================================================
# Configuration Root (required)
# =========================================================
# Root directory containing runtime configs.
# launch.sh resolves this to an absolute path before invoking docker compose,
# so a relative value here works regardless of which scenario is selected.
#
# Layout:
#   config/
#     ardupilot/config/                  ArduPilot params/settings (ardupilot-* scenarios)
#     experiments/                       Mission templates
#     metrics-collector/                 evaluation.yaml, mission.json, scenario_controller.yaml
#     qgroundcontrol/{qgc_config,user_config}
#     unreal-airsim/{condo,xfs}/settings*.json

CONFIG_ROOT=./config


# =========================================================
# Monitoring port overrides (optional)
# =========================================================
# cadvisor publishes on 8080 by default, which clashes with Unreal Editor's
# default web server. Override here if needed.

CADVISOR_HOST_PORT=8085


# =========================================================
# Autonomy / point-cloud registration (ardupilot-xfs)
# =========================================================
# These tune the per-vehicle pointcloud_registration_node that produces
# /<Copter>/registered_point_cloud for local planners. Defaults are sensible;
# override before ./launch.sh ardupilot-xfs.
#
# See compose/ardupilot-xfs/docker-compose.yml for full inline docs.

# Enable per-vehicle registration node (true) or skip entirely (false)
ENABLE_LOCAL_OBS=true

# pointcloud_registration_node target_frame mode:
#   map        -> world-fixed (default, current behavior)
#   base_link  -> per-drone, auto-templates to <vehicle>/base_link (REP 105)
#   <other>    -> literal frame name (e.g. odom)
# LOCAL_OBS_TARGET_FRAME=map

# Rolling buffer length per vehicle in seconds (longer = denser map, more CPU)
LOCAL_OBS_BUFFER_SEC=30.0

# Who publishes map->odom: "sim" (default) or "external" (your own VIO/EKF)
LOCALIZATION_SOURCE=sim

LOCAL_OBS_TARGET_FRAME=base_link

# REP-105 localization stack toggle (default true; rarely needs flipping)
ENABLE_LOCALIZATION=true

# Use /clock instead of wall-clock (true for benchmarking / replay)
USE_SIM_TIME=true

# Static scene PCD publishing (disable if you only want live registration)
ENABLE_STATIC_PCD=false


# =========================================================
# Per-drone bridge knobs (ardupilot-xfs flow)
# =========================================================
# All values below match the defaults in compose/ardupilot-xfs/docker-compose.yml.
# Uncomment + change to override. See compose/ardupilot-xfs/README.md
# ("Tunable env vars (for the autonomy team)" section) for full semantics
# + the SHM caveat at flat domain.
#
# Important: scenario-level .env files (e.g. compose/ardupilot-xfs/.env) are
# NOT auto-loaded by launch.sh under the current invocation pattern. THIS
# root .env is the canonical place to set per-drone bridge values.

# Per-drone AirSim vehicle names (must match settings.json Vehicles keys).
# VEHICLE_1_NAME=Copter1
# VEHICLE_2_NAME=Copter2
# VEHICLE_3_NAME=Copter3
# VEHICLE_4_NAME=Copter4

# AIRSIM_HOST_PORT — RPC port (defaults to 41451). AIRSIM_HOST_IP is
# documented further down ("AirSim host" section).
# AIRSIM_HOST_PORT=41451

# Per-drone DDS ROS_DOMAIN_ID overrides are documented further down
# ("Per-drone ROS_DOMAIN_ID overrides" section).

# Validation-tool-only knobs (test-per-drone-bridges.sh consumers).
# Match BRIDGE_TEST_D{N}_DOMAIN_ID to DRONE_{N}_DOMAIN_ID when overriding.
# BRIDGE_TEST_D1_DOMAIN_ID=1
# BRIDGE_TEST_D2_DOMAIN_ID=2
# BRIDGE_TEST_D3_DOMAIN_ID=3
# BRIDGE_TEST_D4_DOMAIN_ID=4
# WAIT_SEC=30


# =========================================================
# Local Planner Integration (optional)
# =========================================================
# Controls how the local planner is handled by launch.sh
#
# Possible modes:
#
#   disabled
#     Do not start a planner.
#
#   external
#     Planner is assumed to already be running outside this stack.
#
#   managed-script
#     launch.sh will enter LOCAL_PLANNER_DIR and run
#     LOCAL_PLANNER_START_CMD to start the planner.
#
#   managed-compose
#     launch.sh will run docker compose inside LOCAL_PLANNER_DIR
#     using LOCAL_PLANNER_COMPOSE_FILE.

LOCAL_PLANNER_MODE=external


# =========================================================
# Local Planner Script Mode (used if LOCAL_PLANNER_MODE=managed-script)
# =========================================================

# Directory containing the planner repository
LOCAL_PLANNER_DIR=/home/mnsdemo01/Downloads/super_planner/docker/TEVV_docker

# Command used to start the planner
LOCAL_PLANNER_START_CMD="./run.sh"

# Command used to stop the planner
LOCAL_PLANNER_STOP_CMD="make stop"


# =========================================================
# Local Planner Docker Compose Mode (used if LOCAL_PLANNER_MODE=managed-compose)
# =========================================================
# If the planner provides its own docker-compose stack,
# launch.sh can start it automatically.

LOCAL_PLANNER_COMPOSE_FILE=
LOCAL_PLANNER_PROFILE=


# =========================================================
# Sim-side zenoh router (ardupilot-xfs)
# =========================================================
# A single zenoh-bridge-ros2dds container ("sim-router") joins the autonomy
# team's inter-drone mesh on the externally-owned `agent_external` network
# and bridges ONLY ^/shared(/.*)? ROS2 topics. A sim-netns holder owns the
# shared network namespace; sim-router and ros2-x11-node both attach via
# `network_mode: service:sim-netns`, so DDS uses the shared loopback.
#
# `agent_external` is the comms-under-test network. Sensors/clock/tf/control
# do NOT flow through it.

# DDS domain id used by both sim-router (ros2dds plugin) and ros2-x11-node.
# Override only if it conflicts with another DDS instance on the same host.
# SIM_ROS_DOMAIN_ID=0

# ROS distro inside the sim-router image; pinned so the ros2dds plugin
# parses ros_discovery_info correctly. Match ros2-x11-node's distro.
# SIM_ROS_DISTRO=humble

# AirSim host (defaults to host.docker.internal in compose; override only if
# AirSim runs somewhere other than the docker host). Used by ros2-x11-node
# now that it's no longer on host networking.
# AIRSIM_HOST_IP=host.docker.internal

# MAVROS FCU URL. Default dials the router's MAVROS_UDP *server* endpoint at
# 127.0.0.1:14555 (per-instance 14555+i). Multi-drone: DRONE_<N>_FCU_URL.
# MAVROS_FCU_URL=udp://:0@127.0.0.1:14555

# Pre-requisite: the agent_external Docker network must exist and be
# literally named `agent_external` before launch. The autonomy team's
# compose normally creates it; for solo sim testing run:
#   docker network create agent_external \
#     --subnet=172.28.0.0/24 --gateway=172.28.0.254


# =========================================================
# Pixel Streaming (ardupilot-xfs, px4-condo)
# =========================================================
# Opt-in via ENABLE_PIXEL_STREAMING=true (or --with-pixel-streaming).
# When enabled, the pixel-streaming-signalling sidecar starts AND UE5
# is given -PixelStreamingURL pointing to it (browser viewer at
# http://localhost:${PS_HTTP_PORT}). Default false — saves the sidecar
# container, the always-on WebRTC encode pipeline, and the HTTP port.
# Override at launch with the CLI flag (preferred):
#   ./launch.sh ardupilot-xfs --with-pixel-streaming
# CLI flag wins over .env when both are set.

ENABLE_PIXEL_STREAMING=true

# Endpoint config (only consumed when ENABLE_PIXEL_STREAMING=true).
# PIXEL_STREAMING_SIGNALLING_IMAGE=dhdevspace/auto_mns:tevv-pixel-streaming-signalling-5.5
# PS_STREAMER_PORT=8888
# NOTE: the wilbur signalling image hardcodes its HTTP listener on 80 and
# ignores --HttpPort, so this MUST stay 80 — the value is only consumed by
# the healthcheck probe and the browser viewer URL. Any other value leaves
# the container forever "unhealthy" even though streaming works.
PS_HTTP_PORT=80
# PS_PUBLIC_IP=127.0.0.1
# PS_URL=ws://127.0.0.1:8888


# =========================================================
# AirSim XFS display mode (ardupilot-xfs)
# =========================================================
# When true, UE5 runs with -RenderOffScreen (no window, GPU still
# renders for cameras and PixelStreaming). Saves host display bandwidth
# and a chunk of GPU. Override at launch with the CLI flag (preferred):
#   ./launch.sh ardupilot-xfs --headless
# CLI flag wins over .env when both are set.

# Condo image has NO PixelStreaming plugin baked in, so headless (-RenderOffScreen)
# leaves nothing to view (no host window AND no working pixel stream). Keep false
# so condo opens a window on the host X server (DISPLAY).

AIRSIM_HEADLESS=false


# =========================================================
# Bridge architecture (ardupilot-xfs)
# =========================================================
# Default flow uses per-drone airsim_bridge_dN (one per vehicle, isolated
# on agent_internal-N docker networks). DDS-only by default — no
# agent_external connection until WITH_AGENT_EXTERNAL is set.
#
# LEGACY_BRIDGE=true (or --legacy-bridge) falls back to the legacy single
# ros2-x11-node + sim-router stack. WITH_AGENT_EXTERNAL=true (or
# --with-agent-external) adds the four per-drone zenoh bridges onto
# agent_external for /shared/* topic routing. The two flags are mutually
# exclusive (legacy already includes sim-router on agent_external).
# CLI flags win over .env. See compose/ardupilot-xfs/README.md.

# LEGACY_BRIDGE=false
# WITH_AGENT_EXTERNAL=false


# =========================================================
# Per-drone ROS_DOMAIN_ID overrides (ardupilot-xfs default flow)
# =========================================================
# Each airsim_bridge_dN + zenoh-bridge-N pair defaults to ROS_DOMAIN_ID=N
# (1..4) for DDS-layer isolation. Override all four to the same value if
# the autonomy team aligns on a flat domain (e.g. 20). Note: at flat
# domain, bridges discover each other via shared /dev/shm SHM transport
# regardless of docker network isolation — see README's caveat box.

# DRONE_1_DOMAIN_ID=1
# DRONE_2_DOMAIN_ID=2
# DRONE_3_DOMAIN_ID=3
# DRONE_4_DOMAIN_ID=4

# Voxel leaf size for the per-vehicle pointcloud_registration_node.
# Template default is now 0.15m (~540 KB/msg with 30s buffer + 200K pps
# lidar — single DDS fragment, dense in rviz). Override here only if
# you want a different point-density vs DDS-bandwidth trade-off.
# LOCAL_OBS_VOXEL_SIZE=0.15

# =========================================================
# Cameras (generated settings.json — all scenarios)
# =========================================================
# CAMERA_ENABLE=true adds a camera to EVERY vehicle in every generated
# settings.json. Regenerate (any launch does it on drift) and RESTART the
# sim; the bridge auto-discovers it (auto_discover_cameras default true)
# and publishes /<vehicle>/<CAMERA_NAME>_Scene/image. Resolution costs GPU
# + AirSim RPC time per drone — keep modest for multi-drone scenarios.

CAMERA_ENABLE=true
# CAMERA_NAME=Camera1
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# CAMERA_FOV=81

# Fisheye rig (generated settings.json — all scenarios). Independent of the
# pinhole CAMERA block above; both can render at once. Enable adds calibrated
# polynomial fisheyes (FisheyeModel 3) to EVERY vehicle. Count selects layout:
#   4 -> surround ring (Camera_0..3, +/-0.30 offsets, +/-45/+/-135 yaw)
#   1 -> single forward Camera_0
# Regenerate + restart sim after changing. Keep value lines free of inline text.
FISHEYE_ENABLE=false
FISHEYE_COUNT=1
# FISHEYE_WIDTH=618
# FISHEYE_HEIGHT=516
# FISHEYE_FOV=220

# Registered-cloud crop half-extent (m), passed to every bridge as
# local_obs_crop_radius. Finer voxel leaves need a smaller crop (the
# node's overflow guard re-clamps anything finer).
# LOCAL_OBS_CROP_RADIUS=30.0

# =========================================================
# px4-xfs scenario shape
# =========================================================
# First host cpu core for the PX4 SITL pins (drone N -> core BASE+N-1).
# PX4_CPUSET_BASE=8

# =========================================================
# Condo scenario images
# =========================================================
# Condo sim image — deliberately a SEPARATE var from AIRSIM_IMAGE: this
# file pins AIRSIM_IMAGE to the XFS build, which would otherwise hijack
# the condo scenarios via the shared name.
# AIRSIM_CONDO_IMAGE=dhdevspace/auto_mns:tevv-airsim-condo-latest-ceilingless

# QGroundControl image (all scenarios).
# QGC_IMAGE=dhdevspace/auto_mns:airsim-qgc-x11-latest

# --- PostgreSQL / TimescaleDB (telemetry store) ---
# Required by postgres-telemetry in docker-compose-monitoring.yml. Change for non-dev use.
POSTGRES_DB=drone_telemetry
POSTGRES_USER=airsim_user
POSTGRES_PASSWORD=drone_telemetry_dev
AIRSIM_CONDO_IMAGE=dhdevspace/auto_mns:condo-condo-gpulidarfix

