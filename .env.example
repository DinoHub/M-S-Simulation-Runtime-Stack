# =========================================================
# Docker Images (required)
# =========================================================
# Container images used by the simulation stack.
# These must exist locally or be pullable from a registry.

# ardupilot-slim has the per-instance SERIAL port offset baked in
# (run_ardupilot_airsim.sh). The older :ardupilot-latest tag does NOT, and
# multi-drone scenarios (ardupilot-xfs) will hit "bind failed on port 5762".
ARDUPILOT_IMAGE=dhdevspace/auto_mns:ardupilot-slim
AIRSIM_IMAGE=dhdevspace/auto_mns:tevv-airsim-condo-latest-ceilingless
ROS2_IMAGE=dhdevspace/auto_mns:tevv-airstack-ros2-x11-node-release
PX4_IMAGE=dhdevspace/auto_mns:px4-airsim-px4

# zenoh-bridge-ros2dds image used by the sim-side router (ardupilot-xfs).
ZENOH_BRIDGE_IMAGE=eclipse/zenoh-bridge-ros2dds:1.4.0

# =========================================================
# Scenario Selection
# =========================================================
# Selects which compose/<scenario>/docker-compose.yml is used by launch.sh.
# Available scenarios:
#   px4-condo       PX4 SITL + AirSim Condo (single drone, default)
#   px4-xfs         PX4 SITL x4 + AirSim XFS (multi-drone swarm)
#   ardupilot-condo ArduPilot SITL + AirSim Condo (single drone)
#   ardupilot-xfs   ArduPilot SITL x4 + AirSim XFS (multi-drone swarm)
#
# Override on the command line:
#   ./launch.sh ardupilot-condo

SCENARIO=px4-condo


# =========================================================
# Cross-cutting stacks (opt-in)
# =========================================================
# launch.sh starts the simulation only by default. Set these to true to
# also bring up the monitoring (Prometheus/Grafana/Elasticsearch/exporters)
# and metrics (collector + supervisor) stacks.
# CLI flags --with-monitoring / --with-metrics / --all override these.

START_MONITORING=false
START_METRICS=false


# =========================================================
# Configuration Root (required)
# =========================================================
# Root directory containing runtime configs.
# launch.sh resolves this to an absolute path before invoking docker compose,
# so a relative value here works regardless of which scenario is selected.
#
# Layout:
#   config/
#     ardupilot/config/                  ArduPilot params/settings (ardupilot-* scenarios)
#     experiments/                       Mission templates
#     metrics-collector/                 evaluation.yaml, mission.json, scenario_controller.yaml
#     qgroundcontrol/{qgc_config,user_config}
#     unreal-airsim/{condo,xfs}/settings*.json

CONFIG_ROOT=./config


# =========================================================
# Monitoring port overrides (optional)
# =========================================================
# cadvisor publishes on 8080 by default, which clashes with Unreal Editor's
# default web server. Override here if needed.

CADVISOR_HOST_PORT=8085


# =========================================================
# Autonomy / point-cloud registration (ardupilot-xfs)
# =========================================================
# These tune the per-vehicle pointcloud_registration_node that produces
# /<Copter>/registered_point_cloud for local planners. Defaults are sensible;
# override before ./launch.sh ardupilot-xfs.
#
# See compose/ardupilot-xfs/docker-compose.yml for full inline docs.

# Enable per-vehicle registration node (true) or skip entirely (false)
ENABLE_LOCAL_OBS=true

# Rolling buffer length per vehicle in seconds (longer = denser map, more CPU)
LOCAL_OBS_BUFFER_SEC=30.0

# Who publishes map->odom: "sim" (default) or "external" (your own VIO/EKF)
LOCALIZATION_SOURCE=sim

# REP-105 localization stack toggle (default true; rarely needs flipping)
ENABLE_LOCALIZATION=true

# Use /clock instead of wall-clock (true for benchmarking / replay)
USE_SIM_TIME=true

# Static scene PCD publishing (disable if you only want live registration)
ENABLE_STATIC_PCD=true


# =========================================================
# Local Planner Integration (optional)
# =========================================================
# Controls how the local planner is handled by launch.sh
#
# Possible modes:
#
#   disabled
#     Do not start a planner.
#
#   external
#     Planner is assumed to already be running outside this stack.
#
#   managed-script
#     launch.sh will enter LOCAL_PLANNER_DIR and run
#     LOCAL_PLANNER_START_CMD to start the planner.
#
#   managed-compose
#     launch.sh will run docker compose inside LOCAL_PLANNER_DIR
#     using LOCAL_PLANNER_COMPOSE_FILE.

LOCAL_PLANNER_MODE=external


# =========================================================
# Local Planner Script Mode (used if LOCAL_PLANNER_MODE=managed-script)
# =========================================================

# Directory containing the planner repository
LOCAL_PLANNER_DIR=/home/mnsdemo01/Downloads/super_planner/docker/TEVV_docker

# Command used to start the planner
LOCAL_PLANNER_START_CMD="./run.sh"

# Command used to stop the planner
LOCAL_PLANNER_STOP_CMD="make stop"


# =========================================================
# Local Planner Docker Compose Mode (used if LOCAL_PLANNER_MODE=managed-compose)
# =========================================================
# If the planner provides its own docker-compose stack,
# launch.sh can start it automatically.

LOCAL_PLANNER_COMPOSE_FILE=
LOCAL_PLANNER_PROFILE=


# =========================================================
# Sim-side zenoh router (ardupilot-xfs)
# =========================================================
# A single zenoh-bridge-ros2dds container ("sim-router") joins the autonomy
# team's inter-drone mesh on the externally-owned `agent_external` network
# and bridges ONLY ^/shared(/.*)? ROS2 topics. A sim-netns holder owns the
# shared network namespace; sim-router and ros2-x11-node both attach via
# `network_mode: service:sim-netns`, so DDS uses the shared loopback.
#
# `agent_external` is the comms-under-test network. Sensors/clock/tf/control
# do NOT flow through it.

# DDS domain id used by both sim-router (ros2dds plugin) and ros2-x11-node.
# Override only if it conflicts with another DDS instance on the same host.
# SIM_ROS_DOMAIN_ID=0

# ROS distro inside the sim-router image; pinned so the ros2dds plugin
# parses ros_discovery_info correctly. Match ros2-x11-node's distro.
# SIM_ROS_DISTRO=humble

# AirSim host (defaults to host.docker.internal in compose; override only if
# AirSim runs somewhere other than the docker host). Used by ros2-x11-node
# now that it's no longer on host networking.
# AIRSIM_HOST_IP=host.docker.internal

# MAVROS FCU URL (default points to host.docker.internal:14551).
# MAVROS_FCU_URL=udp://:14551@host.docker.internal:14551

# Pre-requisite: the agent_external Docker network must exist and be
# literally named `agent_external` before launch. The autonomy team's
# compose normally creates it; for solo sim testing run:
#   docker network create agent_external \
#     --subnet=172.28.0.0/24 --gateway=172.28.0.254