{
  "_comment": "GENERATED FILE — do not edit by hand. Regenerate via tools/generate_scenario.py. Source: config/unreal-airsim/xfs/templates/settings-ardupilot.json.j2",
  "SeeDocsAt": "https://cosys-lab.github.io/settings/",
  "SettingsVersion": 2.0,
  "SimMode": "Multirotor",
  "ClockSpeed": 1,
  "LocalHostIp": "0.0.0.0",
  "ApiServerPort": 41451,
  "RecordUIVisible": false,
  "MoveWorldOrigin": true,
  "InitialInstanceSegmentation": false,
  "LogMessagesVisible": true,
  "ShowLosDebugLines": false,
  "ViewMode": "FlyWithMe",
  "RpcEnabled": true,
  "EngineSound": false,
  "Wind": { "X": 0, "Y": 0, "Z": 0 },
  "OriginGeopoint": {
    "Latitude": 42.764970,
    "Longitude": -115.579139,
    "Altitude": 1130
  },
  "PawnPaths": {
    "SpiritPawn": {"PawnBP": "Class'/Game/Meshes/BP_SpiritPawn.BP_SpiritPawn_C'"},
    "DjiPawn": {"PawnBP": "Class'/Game/Meshes/BP_MyPawn.BP_MyPawn_C'"}
  },
  "TimeOfDay": {
    "Enabled": false,
    "StartDateTime": "",
    "CelestialClockSpeed": 1,
    "StartDateTimeDst": false,
    "UpdateIntervalSecs": 60
  },
  "Vehicles": {
{% for d in drones %}
    "{{ d.vehicle }}": {
      "VehicleType": "ArduCopter",
      "DefaultVehicleState": "Armed",
      "PawnPath": "SpiritPawn",
      "AutoCreate": true,
      "EnableCollisions": true,
      "AllowAPIAlways": true,
      "X": {{ d.x_offset }}, "Y": 0, "Z": -1, "Yaw": 0,
      "UseSerial": false,
      "LocalHostIp": "172.30.0.10",
      "UdpIp": "172.30.0.{{ 21 + d.instance }}",
      "UdpPort": {{ d.fdm_udp }},
      "ControlIp": "172.30.0.{{ 21 + d.instance }}",
      "ControlPortLocal": {{ d.fdm_tcp }},
      "ControlPortRemote": {{ d.fdm_udp }},
      "Sensors": {
        "Barometer":   { "SensorType": 1, "Enabled": true, "PressureFactorSigma": 0.0001825 },
        "Imu":         { "SensorType": 2, "Enabled": true },
        "Gps":         { "SensorType": 3, "Enabled": true,
                         "EphTimeConstant": 0.3, "EpvTimeConstant": 0.3,
                         "EphInitial": 2.0, "EpvInitial": 3.0,
                         "EphFinal": 0.1, "EpvFinal": 0.1,
                         "EphMin3d": 3.0, "EphMin2d": 4.0,
                         "UpdateLatency": 0.1, "UpdateFrequency": 50, "StartupDelay": 0 },
        "Magnetometer":{ "SensorType": 4, "Enabled": true },
        {# LIDAR_KIND toggle. The Cosys GPU lidar (SensorType 8) uses a NESTED
           schema (BeamPattern/Range/Photometric/Timing) + PublishToShm — the
           flat CPU-lidar keys are silently ignored by it. #}
{% if lidar.kind == 'gpulidar' %}
        "LidarSensor1": {
          "SensorType": 8,
          "Enabled": true,
          "PublishToShm": true,
          "DrawDebugPoints": false,
          "Resolution": 512,
          "_comment": "GPU LiDAR (SensorType 8): GPU-raytraced depth render, so a wide vertical FOV stays cheap (~10Hz) where the single-threaded CPU LiDAR (SensorType 6) collapsed to <1Hz. Nadir-hole radius = altitude / tan(|VerticalFOVLower|); -65deg = ~0.47*alt (tune the lower bound for the gap). Trade-offs vs CPU: single-return only, uniform FOV (no non-uniform VerticalAngles table), render-resolution-limited. Publishes /<veh>/gpulidar/pointsLidarSensor1 (NOT LidarSensor1/points) -> registration reads it via lidar_topic_suffix:=gpulidar/pointsLidarSensor1.",
          "BeamPattern": {
            "Channels": 64,
            "HorizontalFOVStart": 0,
            "HorizontalFOVEnd": 360,
            "VerticalFOVUpper": 15,
            "VerticalFOVLower": -45,
            "MeasurementsPerCycle": 1024
          },
          "Range": {
            "MinRangeMeters": 0.5,
            "MaxRangeMeters": 100
          },
          "Photometric": { "GenerateIntensity": true },
          "Timing": { "RotationsPerSecond": 10, "UpdateFrequency": 10 },
          "X": 0,
          "Y": 0,
          "Z": -1.0,
          "Yaw": 0,
          "Pitch": 0,
          "Roll": 0
        }
{% else %}
        "LidarSensor1":{ "SensorType": 6, "Enabled": true,
                         "NumberOfChannels": 16, "RotationsPerSecond": 30,
                         "PointsPerSecond": 200000,
                         "X": 0, "Y": 0, "Z": 0.5,
                         "Roll": 0, "Pitch": 0, "Yaw": 0,
                         "VerticalFOVUpper": 15, "VerticalFOVLower": -25,
                         "HorizontalFOVStart": -180, "HorizontalFOVEnd": 180,
                         "DrawDebugPoints": false, "ExternalController": false }
{% endif %}
      },
{% include 'config/unreal-airsim/_partials/cameras.json.j2' %}
    }{% if not loop.last %},{% endif %}

{% endfor %}
  },
  "Recording": { "RecordOnMove": false, "RecordInterval": 0.05 }
}
