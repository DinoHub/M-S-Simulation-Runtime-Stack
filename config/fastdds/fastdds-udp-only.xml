<?xml version="1.0" encoding="UTF-8" ?>
<!-- Force rmw_fastrtps onto UDPv4 only: disables the FastDDS shared-memory
     transport. The airsim bridge couples lidar/images to Iceoryx + FastDDS SHM
     data-sharing; on this host that SHM path delivers to no subscriber (not even
     the co-located registration node / rviz), while plain UDP (mavros) works.
     UDP-only also lets the cloud reach the Orin over the network. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
