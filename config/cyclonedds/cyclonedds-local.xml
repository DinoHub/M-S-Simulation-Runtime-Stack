<?xml version="1.0" encoding="UTF-8"?>
<!-- Local (same-host) CycloneDDS: bind to loopback. All ROS containers are
     network_mode:host, so they reach each other on lo. Cross-HOST traffic to the
     Orin goes over zenoh TCP (zenoh-bridge-ros2dds), not raw DDS, so per-host DDS
     on lo is correct. Avoids the enp14s0 hardcode in cyclonedds-sim.xml. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="true" priority="default"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <!-- Default cap is 9 participants/host/domain. Host-networked = one
           participant PER node; the px4-safticity graph (bridge + mavros +
           registration + rviz + every ros2 CLI call) exceeds it and late
           participants fail with "Failed to find a free participant index".
           120 gives headroom (mirrors cyclonedds-sim.xml). -->
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <!-- 10MB receive-buffer floor; needs host net.core.rmem_max>=16MB
           (scripts/setup-host.sh). Without it the OS-default buffer drops
           discovery/data packets on the busy graph (big lidar/registered clouds).
           Current schema (min= attr); the old element is silently ignored. -->
      <SocketReceiveBufferSize min="10MB" />
    </Internal>
  </Domain>
</CycloneDDS>
