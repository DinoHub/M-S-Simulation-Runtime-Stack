# GENERATED from images/catalog.yaml — see docs/adr/0002-one-image-catalog.md. Do not hand-edit; run tools/images.sh sync.
# Immutable review channel. Pins are repo:tag@sha256 — the digest is the
# contract, the tag is there so this file stays readable. A tag can be moved
# onto a different image without this file changing; a digest cannot.
#
# Digests are the *index* (manifest-list) digest, not a per-architecture
# manifest: pinning one architecture's manifest resolves on amd64 and fails
# everywhere else. `docker buildx imagetools inspect <ref> --format
# '{{.Manifest.Digest}}'` gives the right one; `docker manifest inspect -v`
# reports the per-arch entry and is the easy way to get this wrong.
#
# See MnS-Integration-Platform/docs/adr/0001-image-versioning-and-digest-pinning.md
# Bump with: tools/check-image-pins.sh --bump
MNS_PRODUCT_SHELL_IMAGE=dhdevspace/auto_mns:mns-product-shell-v0.2.0-review.3@sha256:d2f712db5ff8906362dffa0137ae83dd97f00c0c749ee0a00a280e4091cb6ae0
MNS_AUTHORING_IMAGE=dhdevspace/auto_mns:mns-authoring-v0.2.0-zones-preview.4@sha256:fa58d138825e2587d3d2f567757fb78555df3abb2ed3e30f3bb919ea7c3ef52c
MNS_STACK_GENERATOR_IMAGE=dhdevspace/auto_mns:mns-stack-generator-v0.2.0-review.22@sha256:337daa0247bc3d19cac169630688920da987a080649eba2579f4b2655134217c
MNS_BLOCKS_IMAGE=dhdevspace/auto_mns:blocks-v0.2.0-review.3@sha256:0b3aec1aa502b9aaef35d1082c0d6c2c33ba18ff9006e832df70b2d05468869a

# The dashboard images publish to a mutable `-latest` tag rather than a review
# channel, so the tag alone told you nothing about which build you were running
# and two people a day apart could run different code with no record of it.
# The digest closes that; the tag stays because it is what gets republished.
# `check-image-pins.sh` reports these as TAG_MOVED when a new one is pushed,
# and --bump keeps the tag while writing the new digest.
DASHBOARD_BACKEND_IMAGE=dhdevspace/auto_mns:tevv-web-dashboard-backend-latest@sha256:65471c7fb8be4e1b643d6139e283ab3f7ed86be2c75e45f8043d24631e869cc1
DASHBOARD_FRONTEND_IMAGE=dhdevspace/auto_mns:tevv-web-dashboard-frontend-latest@sha256:4d6082f36dd89eef44ca367d8e1c49cd7a9d3d73b0374c5fa624a7b098dae078

