MNS_BLOCKS_IMAGE=dhdevspace/auto_mns:blocks-v0.2.0-review.3@sha256:0b3aec1aa502b9aaef35d1082c0d6c2c33ba18ff9006e832df70b2d05468869a

# The dashboard images publish to a mutable `-latest` tag rather than a review
# channel, so the tag alone told you nothing about which build you were running
# and two people a day apart could run different code with no record of it.
# The digest closes that; the tag stays because it is what gets republished.
# `check-image-pins.sh` reports these as TAG_MOVED when a new one is pushed,
# and --bump keeps the tag while writing the new digest.
DASHBOARD_BACKEND_IMAGE=dhdevspace/auto_mns:tevv-web-dashboard-backend-latest@sha256:7a35a448630cf4e104b6996899a08b19205b4deececc4adf526b56abd313a75f
DASHBOARD_FRONTEND_IMAGE=dhdevspace/auto_mns:tevv-web-dashboard-frontend-latest@sha256:9823813753908199bbaca56f51d68e81ab9b225b38c7d0db74695d6392049bf3

# ros2-tools, used by docker-compose-tools.yml. It was the one image this file
# did not cover, so it floated on a mutable `-latest` tag while everything
# around it was digest-pinned — a release that reads as reproducible and has
# one component that is not. Same `-latest` publishing model as the dashboard
# images above, so it gets the same treatment.
AIRSIM_TOOLS_IMAGE=dhdevspace/auto_mns:airsim-tools-v0.2.0-retag.2026-08-26@sha256:3ca0e1cd711addd5c258d323609fa668d91baac4e2547d34e529cb88c759dfd8
