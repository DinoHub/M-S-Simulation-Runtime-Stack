# GENERATED from images/catalog.yaml — see docs/adr/0002-one-image-catalog.md. Do not hand-edit; run tools/images.sh sync.
# Channel-independent tool pins. The product's own images (shell, authoring,
# generator, runtime host, bridge, dashboard) are the release channel's:
# images/v1.0.0.generated.env. Pins are repo:tag@sha256 — the digest is the
# contract, the tag is there so this file stays readable.
#
# Digests are the *index* (manifest-list) digest, not a per-architecture
# manifest: pinning one architecture's manifest resolves on amd64 and fails
# everywhere else. `docker buildx imagetools inspect <ref> --format
# '{{.Manifest.Digest}}'` gives the right one; `docker manifest inspect -v`
# reports the per-arch entry and is the easy way to get this wrong.

# airsim-tools, used by docker-compose-tools.yml (./tools.sh). Its source build
# is unknown, so production freezes the known image behind an immutable dated
# re-tag plus the index digest. The catalog records the source-provenance
# follow-up.
AIRSIM_TOOLS_IMAGE=dhdevspace/auto_mns:airsim-tools-v0.2.0-retag.2026-08-26@sha256:3ca0e1cd711addd5c258d323609fa668d91baac4e2547d34e529cb88c759dfd8
