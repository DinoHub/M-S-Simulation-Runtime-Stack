<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS for casio-edge in a simulation stack: the component's
  requires.dds_config. The generator copies it to the stack's config/dds/
  and every container in the stack, casio's included, reads it as
  /cfg/dds/cyclonedds.xml.

  Every participant sits on one docker bridge network (the stack's
  agent_internal-1), so each container has a single interface and default
  multicast discovery works. This replaces the Jetson's cyclonedds.xml,
  whose interface and peers describe the drone, not this host.

  The receive buffer is raised because a 1280 x 720 rgb8 frame is about
  2.7 MB; with the kernel default a burst of fragments is dropped and the
  image never completes. max, not min: if net.core.rmem_max is lower,
  Cyclone takes what it can instead of refusing to start.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" />
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="default" max="16MB" />
    </Internal>
  </Domain>
</CycloneDDS>
