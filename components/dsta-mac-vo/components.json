{
  "$schema": "../_schema/components.schema.json",
  "schema": "mns.component.v1",
  "id": "dsta-mac-vo",
  "name": "MAC-VO stereo visual odometry (generic adaptor)",
  "version": "0.1.0",
  "kind": "estimator",
  "container": {
    "image": "dhdevspace/auto_mns:mac-vo-ros2-a22f89e-cu128",
    "command": [
      "ros2",
      "run",
      "MACVO_ROS2",
      "MACVO",
      "--config",
      "/mns/config/macvo.yaml"
    ],
    "gpu": true,
    "run_as": "image",
    "environment": {}
  },
  "consumes": [
    "stereo_primary",
    "clock"
  ],
  "produces": {
    "estimate": {
      "topic": "default"
    }
  },
  "record": [
    "/macvo/pose"
  ],
  "ready": {
    "topics": [
      "/mns/estimate/odom"
    ],
    "timeout_s": 300
  },
  "requires": {
    "gpu": {
      "min_vram_gb": 6
    },
    "autopilot": [
      "px4",
      "ardupilot"
    ]
  },
  "scoring": {
    "builtin": "estimate",
    "checks": {
      "ate_rmse_m": {
        "max": 2.0
      },
      "availability": {
        "min": 0.9
      }
    }
  },
  "viz": {
    "layout": "viz/lichtblick-layout.json"
  },
  "adaptor": {
    "inputs": [
      {
        "role": "stereo_primary",
        "left": "/zed/zed_node/left/image_rect_color",
        "right": "/zed/zed_node/right/image_rect_color",
        "encoding": "rgb8",
        "camera_info": "none"
      }
    ],
    "outputs": [
      {
        "from": "/macvo/pose",
        "type": "geometry_msgs/msg/PoseStamped",
        "to": "estimate",
        "body": {
          "frame": "stereo_primary.left",
          "axes": "FRD"
        },
        "world": "first_pose",
        "stamp": "restore_sec",
        "qos": "reliable"
      }
    ],
    "config": [
      {
        "template": "files/macvo.yaml",
        "out": "macvo.yaml"
      }
    ],
    "pacing": {
      "max_inflight": 2,
      "answered_by": "/macvo/pose",
      "timeout_s": 1.0,
      "max_hz": 10
    }
  }
}
