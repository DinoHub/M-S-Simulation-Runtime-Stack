# ArduPilot SITL fleet + AirSim XFS + per-drone ROS2 bridges + QGroundControl.
#
# Drone count and per-drone overrides live in the runtime-stack root .env
# (single source of truth). Scenario shape keys consumed by the generator:
#
#   NUM_DRONES                  drones in the fleet (1..16)
#   VEHICLE_PREFIX              default vehicle name prefix (e.g. "Copter")
#   DRONE_X_SPACING_M           per-drone X offset in AirSim NED frame
#   MAVLINK_PORT_BASE/STRIDE    SITL N -> MAVLink TCP base + N*stride
#   FDM_{TCP,UDP}_PORT_BASE     ArduPilot ↔ AirSim FDM ports
#   FDM_PORT_STRIDE
#   AGENT_INTERNAL_SUBNET_BASE  /24 prefix (e.g. "172.28") for agent_internal-N
#
# Per-drone overrides (optional): VEHICLE_{N}_NAME, DRONE_{N}_DOMAIN_ID.
#
# Default architecture (./launch.sh ardupilot-xfs):
#   - {{ num_drones }}× ArduPilot SITL                 (host net)
#   - AirSim XFS                                       (host net, GPU)
#   - airsim_bridge_d{1..{{ num_drones }}}             (one per drone, on agent_internal-N)
#   - QGroundControl + pixel-streaming-signalling      (host net)
#
# Opt-in (./launch.sh ardupilot-xfs --with-agent-external):
#   - zenoh-bridge-{1..{{ num_drones }}}               (per drone, on agent_internal-N + agent_external)
#
# Per-drone port plan (this render, N={{ num_drones }}):
{% for d in drones %}
#   Instance {{ d.instance }} -> {{ d.vehicle }} : MAVLink TCP {{ d.mavlink_tcp }} ; FDM TCP {{ d.fdm_tcp }} / UDP {{ d.fdm_udp }} ; agent_internal-{{ d.n }} ({{ subnet_base }}.{{ d.subnet_octet }}.0/24)
{% endfor %}

name: ardupilot-xfs

x-ardupilot-base: &ardupilot-base
  image: ${ARDUPILOT_IMAGE:-dhdevspace/auto_mns:ardupilot-slim}
  pull_policy: if_not_present
  restart: "no"
  network_mode: host
  user: "0:0"
  cap_add:
    - SYS_PTRACE
  security_opt:
    - seccomp:unconfined
  healthcheck:
    test: ["CMD-SHELL", "test -f /ardupilot_workspace/ardupilot/build/sitl/bin/arducopter && pgrep -f arducopter"]
    interval: 5s
    timeout: 5s
    retries: 24
    start_period: 120s

# Per-drone airsim_bridge_dN defaults.
x-airsim-bridge: &airsim-bridge-defaults
  image: ${AIRSIM_BRIDGE_IMAGE:-dhdevspace/auto_mns:tevv-airstack-ros2-x11-node-multi-agent-bridge}
  pull_policy: if_not_present
  init: true
  restart: unless-stopped
  ipc: host
  user: "${UID:-1000}:${GID:-1000}"
  profiles: ["per-drone-bridge"]
  extra_hosts:
    - "host.docker.internal:host-gateway"
  volumes:
    - /dev/shm:/dev/shm:rw
    - /tmp/iceoryx2:/tmp/iceoryx2:rw
    - /tmp/.X11-unix:/tmp/.X11-unix:rw
    - ${XAUTHORITY:?set XAUTHORITY}:/tmp/.Xauthority:ro
  depends_on:
    # service_healthy (NOT service_started). The bridge's rpc_dynamic
    # discovery probes AirSim's RPC port on launch; if the port isn't
    # open yet it falls back to explicit-vehicle mode AND the
    # multirotor_node hangs at "Loading settings from AirSim server..."
    # with no retry, leaving every /<vehicle>/* sensor topic with 0
    # publishers. service_healthy gates on airsim-xfs's `nc -z 41451`
    # check, so the bridge only starts after RPC is actually accepting.
    airsim-xfs:
      condition: service_healthy

# Per-drone zenoh-bridge-N defaults. Configs at config/zenoh/zenoh_bridge_drone_{1..N}.json5.
# Profile `agent-external` (NOT `per-drone-bridge`) so zenoh bridges only start
# when the user explicitly opts into agent_external connectivity. Pass
# `./launch.sh ardupilot-xfs --with-agent-external` to activate.
x-zenoh-bridge: &zenoh-bridge-defaults
  image: ${ZENOH_BRIDGE_IMAGE:-eclipse/zenoh-bridge-ros2dds:1.4.0}
  pull_policy: if_not_present
  init: true
  restart: unless-stopped
  profiles: ["agent-external"]
  extra_hosts:
    - "host.docker.internal:host-gateway"

services:

  # ---------------------------------------------------------------------------
  # ArduPilot SITL × {{ num_drones }}
  # ---------------------------------------------------------------------------
{% for d in drones %}
  ardupilot-drone-{{ d.instance }}:
    <<: *ardupilot-base
    container_name: ardupilot-xfs-drone-{{ d.instance }}
    hostname: ardupilot-xfs-drone-{{ d.instance }}
    environment:
      - ARDUPILOT_SIM_HOSTNAME=${ARDUPILOT_SIM_HOSTNAME:-localhost}
      - ARDUPILOT_HOME_LAT=${ARDUPILOT_HOME_LAT:-42.764970}
      - ARDUPILOT_HOME_LON=${ARDUPILOT_HOME_LON:--115.579139}
      - ARDUPILOT_HOME_ALT=${ARDUPILOT_HOME_ALT:-1130}
      - INSTANCE_NUM={{ d.instance }}
    volumes:
      - ./data/ardupilot-xfs/instance_{{ d.instance }}:/ardupilot_workspace/instances/instance_{{ d.instance }}
      - ./data/ardupilot-xfs/logs_{{ d.instance }}:/ardupilot_data/logs
      - ${CONFIG_ROOT}/ardupilot/config:/ardupilot_config:ro
    command: ["{{ d.instance }}"]

{% endfor %}
  # ---------------------------------------------------------------------------
  # AirSim XFS — Unreal Engine simulator with XFS scene.
  # Containerized AirSim with PixelStreaming. Requires the
  # `pixel-streaming-signalling` sidecar (declared below). UE5 dials the
  # signalling URL at startup; without it, the AirSim API socket never
  # opens and ardupilot SITLs can't connect on the per-vehicle FDM ports.
  # View the live scene at http://localhost:${PS_HTTP_PORT:-80}.
  # ---------------------------------------------------------------------------
  airsim-xfs:
    image: ${AIRSIM_IMAGE:-dhdevspace/auto_mns:xfs-latest}
    pull_policy: if_not_present
    container_name: ardupilot-xfs-airsim
    hostname: ardupilot-xfs-airsim
    restart: unless-stopped

    depends_on:
      pixel-streaming-signalling:
        condition: service_healthy

    user: "${UID:-1000}:${GID:-1000}"
    group_add:
      - video
    init: true
    shm_size: "4gb"

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

    environment:
      - NVIDIA_DRIVER_CAPABILITIES=all
      - DISPLAY=${DISPLAY:-:0}
      - SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-x11}
      - XAUTHORITY=/tmp/.Xauthority
      # UE5 PixelStreaming dials this signalling-server URL at startup.
      # Host networking → 127.0.0.1 reaches the pixel-streaming-signalling
      # container.
      - PIXELSTREAMING_URL=${PS_URL:-ws://127.0.0.1:${PS_STREAMER_PORT:-8888}}
      # When true, UE5 runs without a window via -RenderOffScreen. Cameras
      # and PixelStreaming still work; the GUI doesn't pop up. Toggle at
      # launch with: ./launch.sh ardupilot-xfs --headless
      - AIRSIM_HEADLESS=${AIRSIM_HEADLESS:-false}

    network_mode: host
    ipc: host

    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix:rw
      - ${XAUTHORITY:-$HOME/.Xauthority}:/tmp/.Xauthority:ro
      - /dev/shm:/dev/shm:rw
      - /tmp/iceoryx2:/tmp/iceoryx2:rw
      - ${CONFIG_ROOT?set CONFIG_ROOT}/unreal-airsim/xfs/settings-ardupilot.json:/home/airsim_user/Documents/AirSim/settings.json:ro
      - ${CONFIG_ROOT?set CONFIG_ROOT}/unreal-airsim/xfs/settings-ardupilot.json:/app/Xfs/settings.json:ro

    # xfs-latest doesn't ship /usr/local/bin/airsim-entrypoint.sh (the wrapper
    # exists in the condo image only). Pass -PixelStreamingURL directly to
    # the UE5 binary instead — the plugin reads it from CLI when present,
    # ignores it when not. `$$VAR` survives compose interpolation so bash
    # inside the container reads vars from the env block above.
    #
    # AIRSIM_HEADLESS=true selects -RenderOffScreen (off-screen GPU render,
    # cameras still work, no window). false (default) keeps -windowed for
    # interactive use. -NullRHI would skip rendering entirely and break
    # AirSim cameras — do NOT add it.
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        echo "Waiting 5s for ArduPilot SITL fleet to initialize..."
        sleep 5
        if [ "$$AIRSIM_HEADLESS" = "true" ]; then
          DISPLAY_FLAGS="-RenderOffScreen -NoSound -Unattended -NoSplash"
        else
          DISPLAY_FLAGS="-windowed"
        fi
        echo "AirSim display mode: $$DISPLAY_FLAGS"
        exec /app/Xfs/Xfs.sh $$DISPLAY_FLAGS -ResX=1920 -ResY=1080 -PixelStreamingURL=$$PIXELSTREAMING_URL

    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost 41451 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 18
      start_period: 90s

  # ---------------------------------------------------------------------------
  # Pixel Streaming Signalling Server.
  # Bridges the UE5 PixelStreaming plugin (listening on :8888 inside
  # airsim-xfs) and browser viewers. airsim-xfs depends on this being
  # healthy before UE5 starts; without it, UE5 hangs on plugin init and
  # the AirSim API socket never opens. Open http://localhost:${PS_HTTP_PORT}
  # to view the live scene as a WebRTC stream.
  # ---------------------------------------------------------------------------
  pixel-streaming-signalling:
    image: ${PIXEL_STREAMING_SIGNALLING_IMAGE:-dhdevspace/auto_mns:tevv-pixel-streaming-signalling-5.5}
    pull_policy: if_not_present
    container_name: ardupilot-xfs-pixel-streaming-signalling
    hostname: ardupilot-xfs-pixel-streaming-signalling
    restart: unless-stopped
    network_mode: host
    init: true
    environment:
      - PIXELSTREAMING_STREAMER_PORT=${PS_STREAMER_PORT:-8888}
      - PIXELSTREAMING_HTTP_PORT=${PS_HTTP_PORT:-80}
      - PIXELSTREAMING_PUBLIC_IP=${PS_PUBLIC_IP:-127.0.0.1}
    command:
      - --StreamerPort=${PS_STREAMER_PORT:-8888}
      - --HttpPort=${PS_HTTP_PORT:-80}
      - --PublicIp=${PS_PUBLIC_IP:-127.0.0.1}
    # Image (Node.js / wilbur signalling) ships curl/wget/bash/node but NOT nc,
    # ss, or netstat — so the obvious `nc -z` healthcheck always reports
    # "nc: not found" and the container is forever unhealthy. We also avoid
    # `curl -f`: any HTTP response (incl. 404) means the listener is up.
    healthcheck:
      test: ["CMD-SHELL", "curl -sS -m 3 -o /dev/null http://127.0.0.1:${PS_HTTP_PORT:-80}/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 6
      start_period: 20s

  # ===========================================================================
  # PER-DRONE AIRSIM ROS2 BRIDGES (default flow)
  # ===========================================================================
  # {{ num_drones }} airsim_bridge_dN containers, one per vehicle, each on its
  # own agent_internal-N docker network.
  #
  # Each per-drone bridge is its own /clock publisher on its own
  # agent_internal-N network — `enable_coordination=false` everywhere.
  # Don't enable the singleton `airsim_coordination_node` on drone-1:
  # it duplicates the multirotor_node's /clock publisher (an upstream
  # bug in the bridge image), and the two compete with slightly
  # out-of-sync timestamps. tf2's "jump back in time" detector then
  # clears the buffer every few seconds, wiping the registered cloud.
  # Coordination-only topics (/origin_geo_point, /fleet_target_detection,
  # /system_status) had zero subscribers in the live deployment; the
  # claimed `world_ned` static TF doesn't actually publish in this
  # image build. Re-enable per-deployment via env if a future
  # consumer needs them.
  #
  # Domain id strategy: per-drone domains (1..N by default) keep SHM-discovery
  # isolated between bridges. Override with `DRONE_N_DOMAIN_ID=20` if the
  # autonomy team is on a flat domain.
  #
  # Bridge AirSim host: ALWAYS host.docker.internal — the bridges live on
  # isolated `agent_internal-N` networks where 127.0.0.1 means the container
  # itself.
  # ===========================================================================
{% for d in drones %}
  airsim_bridge_d{{ d.n }}:
    <<: *airsim-bridge-defaults
    container_name: airsim_bridge_d{{ d.n }}
    hostname: airsim_bridge_d{{ d.n }}
    environment:
      - DISPLAY=${DISPLAY:-:0}
      - XAUTHORITY=/tmp/.Xauthority
      - ROS_DOMAIN_ID=${DRONE_{{ d.n }}_DOMAIN_ID:-{{ d.domain_id }}}
      - ROS_LOCALHOST_ONLY=0
      - AIRSIM_HOST_IP=host.docker.internal
      - AIRSIM_HOST_PORT=${AIRSIM_HOST_PORT:-41451}
      - VEHICLE_NAME=${VEHICLE_{{ d.n }}_NAME:-{{ d.vehicle }}}
    networks:
      - agent_internal-{{ d.n }}
    command:
      - "bash"
      - "-lc"
      - >
        source /airsim_ros2_ws/install/setup.bash &&
        ros2 launch airsim_ros_pkgs airsim_bringup.launch.py
        host_ip:=host.docker.internal
        host_port:=${AIRSIM_HOST_PORT:-41451}
        vehicles:="['${VEHICLE_{{ d.n }}_NAME:-{{ d.vehicle }}}']"
        enable_localization:=true
        enable_coordination:=false
        enable_local_obs:=${ENABLE_LOCAL_OBS:-true}
        local_obs_target_frame:=${LOCAL_OBS_TARGET_FRAME:-map}
        local_obs_buffer_sec:=${LOCAL_OBS_BUFFER_SEC:-5.0}
        local_obs_voxel_size:=${LOCAL_OBS_VOXEL_SIZE:-0.15}

{% endfor %}
  # ===========================================================================
  # PER-DRONE ZENOH BRIDGES (--with-agent-external profile)
  # ===========================================================================
  # One zenoh-bridge-ros2dds per drone, attached to BOTH its own
  # agent_internal-N (DDS side, sees the airsim_bridge_dN topics) and
  # agent_external (zenoh side, gossips with the autonomy team's
  # autonomy_stack-N peers).
  #
  # Topic ownership (asymmetric):
  #   - drone N publishes /shared/drone_N/* outward to zenoh
  #   - drone N subscribes to /shared/sim/* and /shared/swarm/*
  # See config/zenoh/zenoh_bridge_drone_{1..N}.json5 for details.
  # ===========================================================================
{% for d in drones %}
  zenoh-bridge-{{ d.n }}:
    <<: *zenoh-bridge-defaults
    container_name: ardupilot-xfs-zenoh-bridge-{{ d.n }}
    hostname: zenoh-bridge-{{ d.n }}
    networks:
      - agent_internal-{{ d.n }}
      - agent_external
    environment:
      - RUST_LOG=zenoh=info,zenoh_plugin_ros2dds=info
      - ROS_LOCALHOST_ONLY=0
      - ROS_DISTRO=${SIM_ROS_DISTRO:-humble}
      - ROS_DOMAIN_ID=${DRONE_{{ d.n }}_DOMAIN_ID:-{{ d.domain_id }}}
    command: ["-c", "/etc/zenoh/zenoh_bridge_drone.json5"]
    volumes:
      - ${CONFIG_ROOT?set CONFIG_ROOT}/zenoh/zenoh_bridge_drone_{{ d.n }}.json5:/etc/zenoh/zenoh_bridge_drone.json5:ro
    depends_on:
      airsim_bridge_d{{ d.n }}:
        condition: service_started

{% endfor %}
  # ---------------------------------------------------------------------------
  # QGroundControl X11 — Ground control station with GPU acceleration.
  # ---------------------------------------------------------------------------
  qgroundcontrol-x11:
    image: dhdevspace/auto_mns:airsim-qgc-x11-latest
    pull_policy: if_not_present
    container_name: ardupilot-xfs-qgc
    hostname: ardupilot-xfs-qgc

    network_mode: "host"
    ipc: host

    user: "${UID:-1000}:${GID:-1000}"

    environment:
      DISPLAY: ${DISPLAY:-:0}
      XAUTHORITY: /tmp/.Xauthority
      QT_X11_NO_MITSHM: 1
      QGC_APPIMAGE: /opt/qgroundcontrol/QGroundControl.AppImage
      APPIMAGE_EXTRACT_AND_RUN: "1"
      # Expose full NVIDIA capability set to the container — without this the
      # libGL inside the AppImage falls back to Mesa/llvmpipe and the QGC
      # window renders black on NVIDIA hosts (xdpyinfo passes, GL doesn't).
      NVIDIA_DRIVER_CAPABILITIES: all
      NVIDIA_VISIBLE_DEVICES: all
      LIBGL_ALWAYS_SOFTWARE: 0
      MESA_GL_VERSION_OVERRIDE: "3.3"
      QT_QPA_PLATFORM: xcb

      # ---- QGC AppImage workaround: software Qt Quick backend ----
      # The QGroundControl AppImage in dhdevspace/auto_mns:airsim-qgc-x11-latest
      # bundles its own libGL/Qt5 stack that fails to negotiate a hardware GL
      # context against host NVIDIA — window paints solid black. Software-mode
      # renders the UI fully (slower, no shader effects). The cleaner long-term
      # fix is upstream: rebuild without bundling libGL or replace the AppImage
      # with `apt install qgroundcontrol`. Until then, software stays.
      QT_QUICK_BACKEND: software
      QSG_RENDER_LOOP: basic

    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix:rw
      - ${XAUTHORITY:-$HOME/.Xauthority}:/tmp/.Xauthority:ro
      - ${CONFIG_ROOT?set CONFIG_ROOT}/qgroundcontrol/qgc_config:/config-template:ro
      - ${CONFIG_ROOT?set CONFIG_ROOT}/qgroundcontrol/user_config:/home/qgc/.config/QGroundControl

    devices:
      - /dev/dri:/dev/dri

    shm_size: "2gb"

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, graphics, utility, display]

    security_opt:
      - seccomp:unconfined

    group_add:
      - video

    init: true
    restart: unless-stopped

    healthcheck:
      test: ["CMD-SHELL", "xdpyinfo > /dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

# =============================================================================
# Per-instance state lives in ./data/ardupilot-xfs/{instance_N,logs_N} at the
# repo root (host bind mounts, resolved via --project-directory in launch.sh).
# Inspect with: ls <repo-root>/data/ardupilot-xfs/
# Reset state: rm -rf <that dir>/* && docker compose up
# =============================================================================

networks:
  # Owned by the autonomy team. The Docker network MUST be literally named
  # `agent_external` (not `<project>_agent_external`). For solo sim testing
  # without the autonomy compose, pre-create it:
  #   docker network create agent_external \
  #     --subnet={{ subnet_base }}.0.0/24 --gateway={{ subnet_base }}.0.254
  agent_external:
    external: true

  # Per-drone DDS islands for the airsim_bridge_dN + zenoh-bridge-N pairs.
  # The corresponding autonomy_stack-N container (autonomy team's compose)
  # also attaches to its own agent_internal-N to consume /<vehicle>/* topics
  # via DDS and exchange /shared/drone_N/* via the zenoh bridge.
  #
  # Declared `external: true` because launch.sh creates them up front via
  # `docker network create` (idempotent). The subnet / gateway authority
  # lives in launch.sh's `ensure_agent_internal_networks`.
{% for d in drones %}
  agent_internal-{{ d.n }}:
    external: true
    name: agent_internal-{{ d.n }}
{% endfor %}
