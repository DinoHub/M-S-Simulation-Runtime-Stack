# ArduPilot SITL fleet + AirSim XFS + per-drone ROS2 bridges + QGroundControl.
#
# Drone count and per-drone overrides live in the runtime-stack root .env
# (single source of truth). Scenario shape keys consumed by the generator:
#
#   NUM_DRONES                  drones in the fleet (1..16)
#   VEHICLE_PREFIX              default vehicle name prefix (e.g. "Copter")
#   DRONE_X_SPACING_M           per-drone X offset in AirSim NED frame
#   MAVLINK_PORT_BASE/STRIDE    SITL N -> MAVLink TCP base + N*stride
#   FDM_{TCP,UDP}_PORT_BASE     ArduPilot ↔ AirSim FDM ports
#   FDM_PORT_STRIDE
#   AGENT_INTERNAL_SUBNET_BASE  /24 prefix (e.g. "172.28") for agent_internal-N
#
# Per-drone overrides (optional): VEHICLE_{N}_NAME, DRONE_{N}_DOMAIN_ID.
#
# Env-var interpolation policy: volume mounts use `${VAR:-default}`
# (default-fallback) rather than `${VAR?msg}` (strict-required). Compose
# evaluates all service interpolations during parse — a strict-required
# pattern on ANY service blocks ad-hoc `docker compose up <X>` calls in
# a fresh shell, even when X doesn't need that var. launch.sh always
# exports CONFIG_ROOT / XAUTHORITY before invoking compose, so the
# `:-default` fallback path is never exercised on the recommended path.
#
# Default architecture (./launch.sh ardupilot-xfs):
#   - {{ num_drones }}× ArduPilot SITL                 (host net)
#   - AirSim XFS                                       (host net, GPU)
#   - airsim_bridge_d{1..{{ num_drones }}}             (one per drone, on agent_internal-N)
#   - QGroundControl                                   (host net)
#
# Opt-in flags:
#   --with-agent-external    → zenoh-bridge-{1..{{ num_drones }}} on agent_external
#   --with-pixel-streaming   → pixel-streaming-signalling sidecar + UE5 dials it
#                              (browser viewer at http://localhost:${PS_HTTP_PORT})
#   --headless               → UE5 -RenderOffScreen (no native window)
#
# Per-drone port plan (this render, N={{ num_drones }}):
{% for d in drones %}
#   Instance {{ d.instance }} -> {{ d.vehicle }} : MAVLink TCP {{ d.mavlink_tcp }} ; FDM TCP {{ d.fdm_tcp }} / UDP {{ d.fdm_udp }} ; agent_internal-{{ d.n }} ({{ subnet_base }}.{{ d.subnet_octet }}.0/24)
{% endfor %}

name: ardupilot-xfs

x-ardupilot-base: &ardupilot-base
  image: ${ARDUPILOT_IMAGE:-dhdevspace/auto_mns:ardupilot-slim}
  pull_policy: if_not_present
  restart: "no"
  # network_mode: host removed — SITL now joins sim_net (shared bridge net) with
  # a static IP per drone (assigned in each service below). FDM to AirSim goes to
  # its sim_net IP via ARDUPILOT_SIM_HOSTNAME instead of localhost.
  user: "0:0"
  cap_add:
    - SYS_PTRACE
  security_opt:
    - seccomp:unconfined
  healthcheck:
    test: ["CMD-SHELL", "test -f /ardupilot_workspace/ardupilot/build/sitl/bin/arducopter && pgrep -f arducopter"]
    interval: 5s
    timeout: 5s
    retries: 24
    start_period: 120s

# Per-drone airsim_bridge_dN defaults.
x-airsim-bridge: &airsim-bridge-defaults
  image: ${AIRSIM_BRIDGE_IMAGE:-dhdevspace/auto_mns:airsim-ros2-bridge}
  pull_policy: if_not_present
  init: true
  restart: unless-stopped
  ipc: host
  user: "${UID:-1000}:${GID:-1000}"
  profiles: ["per-drone-bridge"]
  extra_hosts:
    - "host.docker.internal:host-gateway"
  volumes:
    - /dev/shm:/dev/shm:rw
    - /tmp/iceoryx2:/tmp/iceoryx2:rw
    - /tmp/.X11-unix:/tmp/.X11-unix:rw
    - ${XAUTHORITY:-$HOME/.Xauthority}:/tmp/.Xauthority:ro
    # topic_names.yaml: identity renames that pull settings.json sensor/camera
    # topics into the remap set so TOPIC_PREFIX=/ flattens them too (the launch
    # layer's RPC settings-read fails in this image, so those topics would
    # otherwise keep the <vehicle>/ prefix). Inert with the default prefix.
    - ${CONFIG_ROOT:-./config}/airsim-bridge/topic_names.yaml:/etc/airsim/topic_names.yaml:ro
  depends_on:
    # service_healthy (NOT service_started). single_vehicle.launch.py's
    # vehicle node queries AirSim's RPC port on launch ("Loading settings
    # from AirSim server..."); if the port isn't open yet the node hangs
    # with no retry, leaving every /<vehicle>/* sensor topic with 0
    # publishers, and an RPC call landing mid engine-init can crash the
    # sim outright. service_healthy gates on airsim-xfs's healthcheck (RPC
    # port open AND engine init finished), so the bridge only starts once
    # the sim is actually safe to query.
    airsim-xfs:
      condition: service_healthy
      # required: false so --editor (sim profile off) skips this dep instead
      # of forcing the container up; ordering still enforced when sim runs.
      required: false

# Per-drone zenoh-bridge-N defaults. Configs at config/zenoh/zenoh_bridge_drone_{1..N}.json5.
# Profile `agent-external` (NOT `per-drone-bridge`) so zenoh bridges only start
# when the user explicitly opts into agent_external connectivity. Pass
# `./launch.sh ardupilot-xfs --with-agent-external` to activate.
x-zenoh-bridge: &zenoh-bridge-defaults
  image: ${ZENOH_BRIDGE_IMAGE:-eclipse/zenoh-bridge-ros2dds:1.4.0}
  pull_policy: if_not_present
  init: true
  restart: unless-stopped
  profiles: ["agent-external"]
  extra_hosts:
    - "host.docker.internal:host-gateway"

services:

  # ---------------------------------------------------------------------------
  # ArduPilot SITL × {{ num_drones }}
  # ---------------------------------------------------------------------------
{% for d in drones %}
  ardupilot-drone-{{ d.instance }}:
    <<: *ardupilot-base
    container_name: ardupilot-xfs-drone-{{ d.instance }}
    hostname: ardupilot-xfs-drone-{{ d.instance }}
    environment:
      # AirSim reachable on sim_net at 172.30.0.10 (was localhost under host net).
      # arducopter connects its FDM control (--sim-address) here.
      - ARDUPILOT_SIM_HOSTNAME=${ARDUPILOT_SIM_HOSTNAME:-172.30.0.10}
      # MAVLink to QGC: the `stock` flavor pushes UDP to QGC (172.30.0.30:14550,
      # auto-connect); the `slim` image hardcodes its UDP out to loopback, so QGC
      # must CONNECT to the SITL's TCP server at
      # 172.30.0.{{ 21 + d.instance }}:{{ d.mavlink_tcp }} instead. See below.
      - ARDUPILOT_HOME_LAT=${ARDUPILOT_HOME_LAT:-42.764970}
      - ARDUPILOT_HOME_LON=${ARDUPILOT_HOME_LON:--115.579139}
      - ARDUPILOT_HOME_ALT=${ARDUPILOT_HOME_ALT:-1130}
      - INSTANCE_NUM={{ d.instance }}
    networks:
      sim_net:
        # Static IP per drone (.21 + instance) so AirSim's settings.json can
        # address this SITL's FDM sensor port deterministically.
        ipv4_address: 172.30.0.{{ 21 + d.instance }}
    volumes:
      - ./data/ardupilot-xfs/instance_{{ d.instance }}:/ardupilot_workspace/instances/instance_{{ d.instance }}
      - ./data/ardupilot-xfs/logs_{{ d.instance }}:/ardupilot_data/logs
      - ${CONFIG_ROOT}/ardupilot/config:/ardupilot_config:ro
{% if sitl_flavor == 'stock' %}
    # STOCK flavor: dhdevspace/ardupilot-sitl:Copter-4.5.5. Its entrypoint runs
    # sim_vehicle.py (force-overrides --sim-address=127.0.0.1, documented-broken
    # against this AirSim JSON backend), so we bypass it and exec `arducopter`
    # directly with the airsim-copter backend pointed at sim_net static IPs.
    #   --sim-address .10 | --sim-port-out {{ d.fdm_tcp }} (control TO AirSim)
    #                     | --sim-port-in {{ d.fdm_udp }} (sensors FROM AirSim)
    #   --serial0 udp .30:14550  MAVLink push to QGC (auto-connect)
    #   --serial1 tcp:{{ d.mavlink_tcp }}  MAVLink TCP (QGC/MAVROS)
    #   --defaults: copter + AirSim frame + our sim-tuned params (SCHED_LOOP_RATE
    #     200 to match AirSim's ~220Hz + GPS_TYPE 100, so pre-arm passes honestly
    #     with arming checks LIVE — not ARMING_CHECK 0). -w wipes EEPROM.
    image: ${ARDUPILOT_IMAGE:-dhdevspace/ardupilot-sitl:Copter-4.5.5}
    working_dir: /ardupilot
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        # Per-drone MAVLink system id so QGC/MAVROS see distinct vehicles
        # (all SITL share one QGC; -I alone does NOT set SYSID). drone-N -> N+1.
        echo "SYSID_THISMAV {{ d.n }}" > /tmp/sysid.parm
        exec /ardupilot/build/sitl/bin/arducopter \
          -M airsim-copter \
          --sim-address 172.30.0.10 \
          --sim-port-in {{ d.fdm_udp }} \
          --sim-port-out {{ d.fdm_tcp }} \
          -O $$ARDUPILOT_HOME_LAT,$$ARDUPILOT_HOME_LON,$$ARDUPILOT_HOME_ALT,0 \
          --serial0 udpclient:172.30.0.30:14550 \
          --serial1 tcp:{{ d.mavlink_tcp }} \
          --serial2 none \
          --defaults /ardupilot/Tools/autotest/default_params/copter.parm,/ardupilot/Tools/autotest/default_params/airsim-quadX.parm,/ardupilot_config/copter455-airsim.parm,/tmp/sysid.parm \
          -I {{ d.instance }} -w
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f arducopter"]
      interval: 5s
      timeout: 5s
      retries: 24
      start_period: 60s
{% else %}
    # SLIM flavor: dhdevspace/auto_mns:ardupilot-slim, its own entrypoint wraps
    # arducopter (airsim-copter) — command is just the instance number.
    image: ${ARDUPILOT_IMAGE:-dhdevspace/auto_mns:ardupilot-slim}
    command: ["{{ d.instance }}"]
{% endif %}

{% endfor %}
  # ---------------------------------------------------------------------------
  # AirSim XFS — Unreal Engine simulator with XFS scene.
  # PixelStreaming is opt-in: by default UE5 is NOT given -PixelStreamingURL
  # and the `pixel-streaming-signalling` sidecar (declared below) doesn't
  # start (profile: pixel-streaming). Pass --with-pixel-streaming to enable
  # the browser viewer at http://localhost:${PS_HTTP_PORT:-80}; in that
  # mode UE5 dials the signalling URL and the depends_on edge below is
  # active (compose treats depends_on to an inactive-profile service as a
  # no-op, so the default flow doesn't wait for it).
  # ---------------------------------------------------------------------------
  airsim-xfs:
    image: ${AIRSIM_IMAGE:-dhdevspace/auto_mns:xfs-latest}
    # if_not_present (was always): the current xfs-latest with the DLC pak +
    # baked grass exists only locally; `always` re-pulls the stale registry tag
    # and clobbers it. Revert to `always` once the new image is pushed.
    pull_policy: if_not_present
    container_name: ardupilot-xfs-airsim
    hostname: ardupilot-xfs-airsim
    restart: unless-stopped

    # `sim` profile: launch.sh enables it by default, drops it with --editor so
    # AirSim runs from the Unreal editor on the host instead. Bridges depend on
    # this service with required: false, so skipping the profile is clean.
    profiles: ["sim"]

    depends_on:
      pixel-streaming-signalling:
        condition: service_healthy
        # required: false → Compose silently skips the dependency when
        # the `pixel-streaming` profile is inactive (the default). When
        # --with-pixel-streaming is passed and the profile activates,
        # the dependency is enforced (UE5 waits for signalling to be
        # healthy before launching to avoid the dial-too-early hang).
        required: false

    user: "${UID:-1000}:${GID:-1000}"
    group_add:
      - video
    init: true
    shm_size: "4gb"

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

    environment:
      - NVIDIA_DRIVER_CAPABILITIES=all
      - DISPLAY=${DISPLAY:-:0}
      - SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-x11}
      - XAUTHORITY=/tmp/.Xauthority
      # UE5 PixelStreaming dials this signalling-server URL at startup,
      # but ONLY when ENABLE_PIXEL_STREAMING=true (see command block).
      # Host networking → 127.0.0.1 reaches the pixel-streaming-signalling
      # container when the pixel-streaming profile is active.
      # pixel-streaming-signalling is on sim_net at .40 (was 127.0.0.1 under host net).
      - PIXELSTREAMING_URL=${PS_URL:-ws://172.30.0.40:${PS_STREAMER_PORT:-8888}}
      # When true, UE5 runs without a window via -RenderOffScreen. Cameras
      # and PixelStreaming still work; the GUI doesn't pop up. Toggle at
      # launch with: ./launch.sh ardupilot-xfs --headless
      - AIRSIM_HEADLESS=${AIRSIM_HEADLESS:-false}
      # When true, UE5 is given -PixelStreamingURL and the signalling
      # sidecar starts. Default false — browser viewer disabled. Toggle
      # with: ./launch.sh ardupilot-xfs --with-pixel-streaming
      - ENABLE_PIXEL_STREAMING=${ENABLE_PIXEL_STREAMING:-false}
      # Scenario JSON passed to the ScenarioRunner via -scenario=. The map's
      # ScenarioManager carries an editor-authored ABSOLUTE host path (set via
      # the file picker) that does not exist inside the container, so without
      # this flag the scenario fails to load and no obstacles spawn. The
      # command line has higher precedence than the baked path. Set empty to
      # fall back to the baked path (host/editor runs only).
      - SCENARIO_FILE=${SCENARIO_FILE:-/app/Xfs/Xfs/Scenarios/authored/xfs_l_main_obstacles.json}

    # network_mode: host removed — AirSim now lives on sim_net at 172.30.0.10.
    # RPC 41451 + per-vehicle FDM ports bind 0.0.0.0 (settings LocalHostIp) so
    # they're reachable at the sim_net IP. ipc: host kept (shared-memory /dev/shm
    # + iceoryx2 are IPC-namespace, independent of networking).
    ipc: host
    networks:
      sim_net:
        ipv4_address: 172.30.0.10

    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix:rw
      - ${XAUTHORITY:-$HOME/.Xauthority}:/tmp/.Xauthority:ro
      - /dev/shm:/dev/shm:rw
      - /tmp/iceoryx2:/tmp/iceoryx2:rw
      - ${CONFIG_ROOT:-./config}/unreal-airsim/xfs/settings-ardupilot.json:/home/airsim_user/Documents/AirSim/settings.json:ro
      - ${CONFIG_ROOT:-./config}/unreal-airsim/xfs/settings-ardupilot.json:/app/Xfs/settings.json:ro

    # xfs-latest doesn't ship /usr/local/bin/airsim-entrypoint.sh (the wrapper
    # exists in the condo image only). Pass -PixelStreamingURL directly to
    # the UE5 binary — but only when ENABLE_PIXEL_STREAMING=true. Otherwise
    # the plugin would dial an unreachable signalling endpoint (the sidecar
    # is profile-gated off by default) and hang on init. `$$VAR` survives
    # compose interpolation so bash inside the container reads vars from
    # the env block above.
    #
    # AIRSIM_HEADLESS=true selects -RenderOffScreen (off-screen GPU render,
    # cameras still work, no window). false (default) keeps -windowed for
    # interactive use. -NullRHI would skip rendering entirely and break
    # AirSim cameras — do NOT add it.
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        echo "Waiting 5s for ArduPilot SITL fleet to initialize..."
        sleep 5
        if [ "$$AIRSIM_HEADLESS" = "true" ]; then
          DISPLAY_FLAGS="-RenderOffScreen -NoSound -Unattended -NoSplash"
        else
          DISPLAY_FLAGS="-windowed"
        fi
        PS_FLAG=""
        if [ "$$ENABLE_PIXEL_STREAMING" = "true" ]; then
          PS_FLAG="-PixelStreamingURL=$$PIXELSTREAMING_URL"
        fi
        SCENARIO_FLAG=""
        if [ -n "$$SCENARIO_FILE" ]; then
          SCENARIO_FLAG="-scenario=$$SCENARIO_FILE"
        fi
        echo "AirSim display mode: $$DISPLAY_FLAGS"
        echo "AirSim pixel-streaming: $$ENABLE_PIXEL_STREAMING"
        echo "AirSim scenario: $${SCENARIO_FILE:-<map default>}"
        exec /app/Xfs/Xfs.sh $$DISPLAY_FLAGS -ResX=1920 -ResY=1080 $$PS_FLAG $$SCENARIO_FLAG

    # Health = RPC port open *and* the engine has finished bringing the level
    # up. Plain `nc -z 41451` flips healthy the instant ASimModeBase::startApiServer()
    # opens the listen socket — but that can be a few frames before vehicles are
    # safe to query, and an early RPC call from a bridge's rpc_dynamic discovery
    # then SIGSEGVs the sim (it crashes, Docker restarts it, second time the
    # bridge has backed off so it survives — the classic "always crashes first").
    # Gating additionally on the "Display Control listening" log line (emitted at
    # the tail of engine init) plus a long start_period pushes bridge startup
    # past that window. (The durable fix is plugin-side; this is the band-aid.)
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost 41451 && grep -q 'Display Control listening on port' /app/Xfs/Xfs/Saved/Logs/Xfs.log || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 24
      start_period: 150s

  # ---------------------------------------------------------------------------
  # Pixel Streaming Signalling Server.
  # Bridges the UE5 PixelStreaming plugin (listening on :8888 inside
  # airsim-xfs) and browser viewers. Opt-in via the `pixel-streaming`
  # profile: pass --with-pixel-streaming to launch.sh (or set
  # ENABLE_PIXEL_STREAMING=true). When the profile is inactive, this
  # service isn't created AND the airsim-xfs depends_on edge above is
  # silently dropped — UE5 launches without -PixelStreamingURL and the
  # plugin stays idle. Open http://localhost:${PS_HTTP_PORT} to view the
  # live scene as a WebRTC stream when enabled.
  # ---------------------------------------------------------------------------
  pixel-streaming-signalling:
    image: ${PIXEL_STREAMING_SIGNALLING_IMAGE:-dhdevspace/auto_mns:tevv-pixel-streaming-signalling-5.5}
    pull_policy: if_not_present
    container_name: ardupilot-xfs-pixel-streaming-signalling
    hostname: ardupilot-xfs-pixel-streaming-signalling
    restart: unless-stopped
    profiles: ["pixel-streaming"]
    # On sim_net at .40: UE5 (172.30.0.10) dials the streamer at .40:8888
    # container-to-container; publish the HTTP viewer port to the host so a
    # browser on the host can reach it. (WebRTC media may need extra published
    # ports for remote viewers — fine for a local host browser.)
    networks:
      sim_net:
        ipv4_address: 172.30.0.40
    ports:
      - "${PS_HTTP_PORT:-80}:${PS_HTTP_PORT:-80}"
    init: true
    environment:
      - PIXELSTREAMING_STREAMER_PORT=${PS_STREAMER_PORT:-8888}
      - PIXELSTREAMING_HTTP_PORT=${PS_HTTP_PORT:-80}
      - PIXELSTREAMING_PUBLIC_IP=${PS_PUBLIC_IP:-127.0.0.1}
    command:
      - --StreamerPort=${PS_STREAMER_PORT:-8888}
      - --HttpPort=${PS_HTTP_PORT:-80}
      - --PublicIp=${PS_PUBLIC_IP:-127.0.0.1}
    # Image (Node.js / wilbur signalling) ships curl/wget/bash/node but NOT nc,
    # ss, or netstat — so the obvious `nc -z` healthcheck always reports
    # "nc: not found" and the container is forever unhealthy. We also avoid
    # `curl -f`: any HTTP response (incl. 404) means the listener is up.
    healthcheck:
      test: ["CMD-SHELL", "curl -sS -m 3 -o /dev/null http://127.0.0.1:${PS_HTTP_PORT:-80}/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 6
      start_period: 20s

  # ===========================================================================
  # PER-DRONE AIRSIM ROS2 BRIDGES (default flow)
  # ===========================================================================
  # {{ num_drones }} airsim_bridge_dN containers, one per vehicle, each on its
  # own agent_internal-N docker network.
  #
  # Each per-drone bridge is its own /clock publisher on its own
  # agent_internal-N network — `enable_coordination=false` everywhere.
  # Don't enable the singleton `airsim_coordination_node` on drone-1:
  # it duplicates the multirotor_node's /clock publisher (an upstream
  # bug in the bridge image), and the two compete with slightly
  # out-of-sync timestamps. tf2's "jump back in time" detector then
  # clears the buffer every few seconds, wiping the registered cloud.
  # Coordination-only topics (/origin_geo_point, /fleet_target_detection,
  # /system_status) had zero subscribers in the live deployment; the
  # claimed `world_ned` static TF doesn't actually publish in this
  # image build. Re-enable per-deployment via env if a future
  # consumer needs them.
  #
  # Domain id strategy: per-drone domains (1..N by default) keep SHM-discovery
  # isolated between bridges. Override with `DRONE_N_DOMAIN_ID=20` if the
  # autonomy team is on a flat domain.
  #
  # Bridge AirSim host: ALWAYS host.docker.internal — the bridges live on
  # isolated `agent_internal-N` networks where 127.0.0.1 means the container
  # itself.
  # ===========================================================================
{% for d in drones %}
  airsim_bridge_d{{ d.n }}:
    <<: *airsim-bridge-defaults
    container_name: airsim_bridge_d{{ d.n }}
    hostname: airsim_bridge_d{{ d.n }}
    environment:
      # HOME must point at a writable dir: the container runs as uid 1000,
      # which is absent from the image's /etc/passwd, so HOME would default
      # to / and `ros2 launch` would fail to create its ~/.ros/log dir.
      - HOME=/tmp
      - DISPLAY=${DISPLAY:-:0}
      - XAUTHORITY=/tmp/.Xauthority
      - ROS_DOMAIN_ID=${DRONE_{{ d.n }}_DOMAIN_ID:-{{ d.domain_id }}}
      - ROS_LOCALHOST_ONLY=0
      # AirSim now on sim_net at 172.30.0.10 (was host.docker.internal / host net).
      - AIRSIM_HOST_IP=${AIRSIM_HOST_IP:-172.30.0.10}
      - AIRSIM_HOST_PORT=${AIRSIM_HOST_PORT:-41451}
      - VEHICLE_NAME=${VEHICLE_{{ d.n }}_NAME:-{{ d.vehicle }}}
    networks:
      # DDS island toward the autonomy stack (unchanged boundary).
      agent_internal-{{ d.n }}: {}
      # sim_net: reach AirSim RPC (172.30.0.10) container-to-container instead of
      # via the host gateway. Static .5N keeps the bridge's address stable.
      sim_net:
        ipv4_address: 172.30.0.{{ 50 + d.n }}
    # The image ENTRYPOINT sources ROS + the bridge workspace, then exec's
    # this argv directly — no `bash -lc "source ... && ..."` wrapper needed.
    # single_vehicle.launch.py pins this instance to exactly one vehicle via
    # vehicle_name:= (airsim_bringup.launch.py's vehicles:= is only an
    # RPC-discovery fallback and would otherwise bridge ALL vehicles).
    command:
      - "ros2"
      - "launch"
      - "airsim_ros2_bridge"
      - "single_vehicle.launch.py"
      - "vehicle_name:=${VEHICLE_{{ d.n }}_NAME:-{{ d.vehicle }}}"
      # Per-vehicle topic prefix. Default `{vehicle}/` -> /<vehicle>/odom etc.
      # Set TOPIC_PREFIX=/ to flatten every topic to root (/odom, /imu,
      # /LidarSensor1/points). Use `/`, NOT empty: this is compose exec-form
      # (no shell), so an empty value passes the literal argv token
      # `topic_prefix:=` and `ros2 launch` rejects it ("malformed launch
      # argument"). `/` resolves to the same flat root ("/" + rel.lstrip("/"))
      # and is a valid non-empty value. `:-` coerces an accidental empty back to
      # the prefixed default rather than crash-looping the bridge. Each bridge
      # runs ONE vehicle on its own agent_internal-N net + ROS_DOMAIN_ID, so
      # flat names across drones don't collide (separate DDS domains).
      # NOTE: TF frame_ids stay <vehicle>/base_link (frames aren't renamed).
      - "topic_prefix:=${TOPIC_PREFIX:-{vehicle}/}"
      # Explicit renames (identity) that force settings-driven sensor/camera
      # topics into the remap set — see the mounted topic_names.yaml. Needed
      # because the launch RPC settings-read fails here; without it TOPIC_PREFIX=/
      # only flattens the fixed core topics.
      - "topic_names_config:=/etc/airsim/topic_names.yaml"
      - "host_ip:=${AIRSIM_HOST_IP:-172.30.0.10}"
      - "host_port:=${AIRSIM_HOST_PORT:-41451}"
      - "enable_localization:=true"
      - "enable_coordination:=false"
      - "enable_local_obs:=${ENABLE_LOCAL_OBS:-true}"
      - "local_obs_target_frame:=${LOCAL_OBS_TARGET_FRAME:-map}"
      - "local_obs_buffer_sec:=${LOCAL_OBS_BUFFER_SEC:-5.0}"
      - "local_obs_voxel_size:=${LOCAL_OBS_VOXEL_SIZE:-0.15}"
      - "local_obs_crop_radius:=${LOCAL_OBS_CROP_RADIUS:-30.0}"
      # LiDAR input topic for the registration backend. Derived from
      # LIDAR_KIND (lidar -> LidarSensor1/points, gpulidar ->
      # gpulidar/pointsLidarSensor1) so the one toggle keeps sim + bridge in
      # sync; LIDAR_TOPIC_SUFFIX still overrides at runtime.
      - "lidar_topic_suffix:=${LIDAR_TOPIC_SUFFIX:-{{ lidar.topic_suffix }}}"

{% endfor %}
  # ===========================================================================
  # PER-DRONE ZENOH BRIDGES (--with-agent-external profile)
  # ===========================================================================
  # One zenoh-bridge-ros2dds per drone, attached to BOTH its own
  # agent_internal-N (DDS side, sees the airsim_bridge_dN topics) and
  # agent_external (zenoh side, gossips with the autonomy team's
  # autonomy_stack-N peers).
  #
  # Topic ownership (asymmetric):
  #   - drone N publishes /shared/drone_N/* outward to zenoh
  #   - drone N subscribes to /shared/sim/* and /shared/swarm/*
  # See config/zenoh/zenoh_bridge_drone_{1..N}.json5 for details.
  # ===========================================================================
{% for d in drones %}
  zenoh-bridge-{{ d.n }}:
    <<: *zenoh-bridge-defaults
    container_name: ardupilot-xfs-zenoh-bridge-{{ d.n }}
    hostname: zenoh-bridge-{{ d.n }}
    networks:
      - agent_internal-{{ d.n }}
      - agent_external
    environment:
      - RUST_LOG=zenoh=info,zenoh_plugin_ros2dds=info
      - ROS_LOCALHOST_ONLY=0
      - ROS_DISTRO=${SIM_ROS_DISTRO:-humble}
      - ROS_DOMAIN_ID=${DRONE_{{ d.n }}_DOMAIN_ID:-{{ d.domain_id }}}
    command: ["-c", "/etc/zenoh/zenoh_bridge_drone.json5"]
    volumes:
      - ${CONFIG_ROOT:-./config}/zenoh/zenoh_bridge_drone_{{ d.n }}.json5:/etc/zenoh/zenoh_bridge_drone.json5:ro
    depends_on:
      airsim_bridge_d{{ d.n }}:
        condition: service_started

{% endfor %}
  # ---------------------------------------------------------------------------
  # QGroundControl X11 — Ground control station with GPU acceleration.
  # ---------------------------------------------------------------------------
  qgroundcontrol-x11:
    image: ${QGC_IMAGE:-dhdevspace/auto_mns:airsim-qgc-x11-latest}
    pull_policy: if_not_present
    container_name: ardupilot-xfs-qgc
    hostname: ardupilot-xfs-qgc

    # On sim_net at .30. The shipped ardupilot-slim image hardcodes its MAVLink
    # UDP out to loopback, so QGC must CONNECT to each SITL's MAVLink TCP server
    # (172.30.0.2N:576X) — add a TCP comm link in QGC (Comm Links -> Add -> TCP
    # -> host 172.30.0.21 port 5760, +10/drone). X11/GPU below are net-independent.
    ipc: host
    networks:
      sim_net:
        ipv4_address: 172.30.0.30

    user: "${UID:-1000}:${GID:-1000}"

    environment:
      DISPLAY: ${DISPLAY:-:0}
      XAUTHORITY: /tmp/.Xauthority
      QT_X11_NO_MITSHM: 1
      QGC_APPIMAGE: /opt/qgroundcontrol/QGroundControl.AppImage
      APPIMAGE_EXTRACT_AND_RUN: "1"
      # Expose full NVIDIA capability set to the container — without this the
      # libGL inside the AppImage falls back to Mesa/llvmpipe and the QGC
      # window renders black on NVIDIA hosts (xdpyinfo passes, GL doesn't).
      NVIDIA_DRIVER_CAPABILITIES: all
      NVIDIA_VISIBLE_DEVICES: all
      LIBGL_ALWAYS_SOFTWARE: 0
      MESA_GL_VERSION_OVERRIDE: "3.3"
      QT_QPA_PLATFORM: xcb

      # ---- QGC AppImage workaround: software Qt Quick backend ----
      # The QGroundControl AppImage in dhdevspace/auto_mns:airsim-qgc-x11-latest
      # bundles its own libGL/Qt5 stack that fails to negotiate a hardware GL
      # context against host NVIDIA — window paints solid black. Software-mode
      # renders the UI fully (slower, no shader effects). The cleaner long-term
      # fix is upstream: rebuild without bundling libGL or replace the AppImage
      # with `apt install qgroundcontrol`. Until then, software stays.
      QT_QUICK_BACKEND: software
      QSG_RENDER_LOOP: basic

    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix:rw
      - ${XAUTHORITY:-$HOME/.Xauthority}:/tmp/.Xauthority:ro
      - ${CONFIG_ROOT:-./config}/qgroundcontrol/qgc_config:/config-template:ro
      - ${CONFIG_ROOT:-./config}/qgroundcontrol/user_config:/home/qgc/.config/QGroundControl

    devices:
      - /dev/dri:/dev/dri

    shm_size: "2gb"

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, graphics, utility, display]

    security_opt:
      - seccomp:unconfined

    group_add:
      - video

    init: true
    restart: unless-stopped

    healthcheck:
      test: ["CMD-SHELL", "xdpyinfo > /dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

# =============================================================================
# Per-instance state lives in ./data/ardupilot-xfs/{instance_N,logs_N} at the
# repo root (host bind mounts, resolved via --project-directory in launch.sh).
# Inspect with: ls <repo-root>/data/ardupilot-xfs/
# Reset state: rm -rf <that dir>/* && docker compose up
# =============================================================================

networks:
  # Shared sim bridge network — AirSim, the ArduPilot SITL drones, and the
  # per-drone bridges all attach here so FDM (900x) + RPC (41451) traverse a
  # user-defined bridge by static IP instead of host loopback. Compose-managed
  # (project-scoped, ipam-assigned) since it is sim-internal — distinct, non-
  # overlapping subnet from agent_internal-N (172.28.x). Static IP plan:
  #   AirSim .10 | drone-N .2(1+N) | airsim_bridge_dN .5N   (QGC/pixel added later)
  sim_net:
    driver: bridge
    ipam:
      config:
        - subnet: ${SIM_NET_SUBNET:-172.30.0.0/24}
          gateway: ${SIM_NET_GATEWAY:-172.30.0.254}

  # Owned by the autonomy team. The Docker network MUST be literally named
  # `agent_external` (not `<project>_agent_external`). For solo sim testing
  # without the autonomy compose, pre-create it:
  #   docker network create agent_external \
  #     --subnet={{ subnet_base }}.0.0/24 --gateway={{ subnet_base }}.0.254
  agent_external:
    external: true

  # Per-drone DDS islands for the airsim_bridge_dN + zenoh-bridge-N pairs.
  # The corresponding autonomy_stack-N container (autonomy team's compose)
  # also attaches to its own agent_internal-N to consume /<vehicle>/* topics
  # via DDS and exchange /shared/drone_N/* via the zenoh bridge.
  #
  # Declared `external: true` because launch.sh creates them up front via
  # `docker network create` (idempotent). The subnet / gateway authority
  # lives in launch.sh's `ensure_agent_internal_networks`.
{% for d in drones %}
  agent_internal-{{ d.n }}:
    external: true
    name: agent_internal-{{ d.n }}
{% endfor %}
