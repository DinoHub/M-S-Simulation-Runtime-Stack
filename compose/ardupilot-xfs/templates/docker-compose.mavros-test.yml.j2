# Per-drone MAVROS integration test (the agent_internal-N → MAVROS → FCU →
# SITL → AirSim chain).
#
# Distinct compose project name (`ardupilot-xfs-mavros-test`) so that
# `down --remove-orphans` here doesn't sweep up the main `ardupilot-xfs`
# project's airsim_bridge_dN / SITL / etc.
#
# Brings up {{ num_drones }} mavros_dN containers, one per drone:
#
#   mavros_dN  ─(agent_internal-N)─►  airsim_bridge_dN
#       │
#       └────(sim_net MAVLink TCP 172.30.0.2N:{{ mavlink_port_base }}+10(N-1))────►  ardupilot-drone-{N-1}
#                                                       │
#                                                       └──►  AirSim XFS
#
# The SITL drones live on sim_net (no host-published MAVLink ports since the
# feat/sim-bridge-net migration), so each mavros_dN also joins sim_net and
# dials the drone's static IP directly. sim_net is project-scoped to the main
# stack; referenced here as an external network via SIM_NET_NAME.
#
# Use via ./test-per-drone-mavros.sh (orchestrator) — that script also runs
# the per-drone arm/takeoff/setpoint/land mission inside each mavros_dN.
#
# Bring-up:   docker compose -f docker-compose.mavros-test.yml up -d
# Tear-down:  docker compose -f docker-compose.mavros-test.yml down
#
# Prereq: the main stack is up (./launch.sh ardupilot-xfs). The mavros
# containers depend on the airsim_bridge_dN being healthy so that ROS2
# topic discovery on agent_internal-N is already warm.

name: ardupilot-xfs-mavros-test

x-mavros: &mavros-defaults
  # Same image family as airsim_bridge_dN — already ships airsim_mavros_bringup
  # + mavros + mavros_msgs. Fallback matches the main compose's fallback.
  image: ${AIRSIM_BRIDGE_IMAGE:-dhdevspace/auto_mns:airsim-ros2-bridge}
  pull_policy: if_not_present
  # init: false (intentional). mavros_bringup.launch.py's DDS cleanup step
  # (enable_dds_cleanup, on for d1 only) forks children; with tini as PID 1
  # they get re-parented to tini and never finish, hanging bring-up. The
  # `bash -lc` wrapper below keeps bash as PID 1 so it reaps them cleanly.
  # Verified empirically.
  init: false
  restart: unless-stopped
  ipc: host
  # Avoid the X11 entrypoint's root→1000 user-switch that strips DISPLAY
  # (same quirk as airsim_bridge_dN).
  user: "${UID:-1000}:${GID:-1000}"
  extra_hosts:
    - "host.docker.internal:host-gateway"
  volumes:
    - /dev/shm:/dev/shm:rw
    - /tmp/.X11-unix:/tmp/.X11-unix:rw
    - ${XAUTHORITY:?set XAUTHORITY}:/tmp/.Xauthority:ro
    # Bind-mount the per-drone mission script so updates land without
    # rebuilding. compose resolves ${PWD} to the directory it was invoked
    # from — test-per-drone-mavros.sh `cd`s here first.
    - ${PWD}/scripts/test_one_drone_mavros.py:/scripts/test_one_drone_mavros.py:ro

services:
{% for d in drones %}
  mavros_d{{ d.n }}:
    <<: *mavros-defaults
    container_name: mavros_d{{ d.n }}
    hostname: mavros_d{{ d.n }}
    environment:
      # HOME must point at a writable dir — uid 1000 is absent from the
      # image's /etc/passwd, so HOME defaults to / and `ros2 launch` cannot
      # create its ~/.ros/log dir (same fix as airsim_bridge_dN).
      - HOME=/tmp
      - DISPLAY=${DISPLAY:-:0}
      - XAUTHORITY=/tmp/.Xauthority
      - ROS_DOMAIN_ID=${DRONE_{{ d.n }}_DOMAIN_ID:-{{ d.domain_id }}}
      - ROS_LOCALHOST_ONLY=0
    networks:
      # agent_internal-N: DDS island shared with airsim_bridge_dN (+ planner).
      # sim_net: reach the SITL's MAVLink TCP server at its static IP — the
      # drones are NOT on the host network anymore, so host.docker.internal
      # cannot reach {{ d.mavlink_tcp }}.
      - agent_internal-{{ d.n }}
      - sim_net
    # bash -lc wrapper retained on purpose: it keeps bash as PID 1 (see the
    # `init: false` note above). The image ENTRYPOINT already sources ROS +
    # the workspace, so no explicit `source` line is needed.
    command:
      - "bash"
      - "-lc"
      - >
        ros2 launch airsim_mavros_bringup mavros_bringup.launch.py
        vehicle:={{ d.vehicle }}
        fcu_url:=tcp://172.30.0.{{ 21 + d.instance }}:{{ d.mavlink_tcp }}
        target_system_id:={{ d.n }}
        mavros_config:=mavros_ardupilot.yaml
        enable_dds_cleanup:={{ "true" if d.n == 1 else "false" }}

{% endfor %}
networks:
{% for d in drones %}
  agent_internal-{{ d.n }}: { external: true, name: agent_internal-{{ d.n }} }
{% endfor %}
  # Main stack's project-scoped sim bridge net (holds the SITL MAVLink TCP
  # servers at 172.30.0.2N). The main compose sets `name: ardupilot-xfs`, so
  # the docker network is ardupilot-xfs_sim_net. Override with SIM_NET_NAME
  # if the project name differs.
  sim_net: { external: true, name: "${SIM_NET_NAME:-ardupilot-xfs_sim_net}" }
