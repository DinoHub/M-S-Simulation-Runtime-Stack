generated/

# python
.venv

/.mns/
/runs/
/generated/
/scenarios/*
# The reference campaign is a whole directory:
# the spec, the campaign over it, the route it flies and the estimator
# calibration are one committed unit, because a campaign that ships half of
# itself cannot be copied and run.
!/scenarios/vio-reference/
# Same reasoning: the spec is meaningless without the calibration beside it.
!/scenarios/vio-osmo-condo/
!/scenarios/vio-osmo-condo-ardupilot/
!/scenarios/vio-osmo-xfs/
!/scenarios/vio-osmo-xfs-ardupilot/
!/scenarios/vio-osmo-xfs-surround/
!/scenarios/fisheye-surround-shm/
# The stereo rig with no estimator: components attach to it from outside.
!/scenarios/stereo-xfs/
# The TEVV example tests: each scenario is one test, its component attached
# at run time (tevv run <scenario> --component <package>).
!/scenarios/openvins-yard-box/
!/scenarios/openvins-yard-zigzag/
!/scenarios/super-yard-square/
!/scenarios/super-yard-detour/
# Four fisheyes on one shared cubemap, the rig the dashboard's camera rig editor makes.
!/scenarios/fisheye-surround-xfs/
/scenarios/fisheye-surround-xfs/phase-state.json
/scenarios/fisheye-surround-xfs/ScenarioSpec.baseline.yaml
!/scenarios/vio-reference/**
